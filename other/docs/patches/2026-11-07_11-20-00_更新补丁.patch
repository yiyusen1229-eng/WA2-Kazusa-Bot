+# -*- coding: utf-8 -*-
+"""参考音频：文本配对、随机抽取、无文本的只做兜底。
+
+    cd program && .\\build_env\\venv\\Scripts\\python.exe tools\\test_ref_texts.py
+"""
+import io
+import os
+import shutil
+import sys
+import tempfile
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+HERE = os.path.dirname(os.path.abspath(__file__))
