+# -*- coding: utf-8 -*-
+"""补参考音频文本：来源扩展为「训练清单(.list) + 标注结果.json」。
+
+清单格式：path|speaker|lang|text（GPT-SoVITS 训练清单），覆盖比标注结果全得多。
+规则仍与现有 .txt 一致：用清单里的原文，去掉首尾「」，内部换行直接拼接，不覆盖已有文件。
+"""
+import io
+import json
+import os
+import sys
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+VOICE = os.path.join(PROGRAM, "build_env", "characters", "和纱", "voice")
+SET = os.path.join(os.path.dirname(PROGRAM), "other", "dev", "语音训练集")
+
+
+def clean(text):
+    s = (text or "").replace("\r", "").strip()
+    if s.startswith("「"):
+        s = s[1:]
+    if s.endswith("」"):
+        s = s[:-1]
+    return s.replace("\n", "").strip()
+
+
+def load_sources():
+    out = {}
+    # 训练清单（3 份，后者不覆盖前者的已有值）
+    for fn in ("gpt_sovits.list", "gpt_sovits_全量.list", "GPT-SoVITS清单.list"):
+        p = os.path.join(SET, fn)
+        if not os.path.isfile(p):
+            continue
+        for line in io.open(p, encoding="utf-8", errors="replace").read().splitlines():
+            parts = line.split("|")
+            if len(parts) < 4:
+                continue
+            base = os.path.splitext(os.path.basename(parts[0]))[0].lower()
+            t = clean("|".join(parts[3:]))
+            if base and t:
+                out.setdefault(base, t)
+    # 标注结果（有 text 用 text，否则 asr）
+    p = os.path.join(SET, "标注结果.json")
+    if os.path.isfile(p):
+        for e in json.loads(io.open(p, encoding="utf-8").read()):
+            base = os.path.splitext((e.get("wav") or "").lower())[0]
+            t = clean(e.get("text") or "") or (e.get("asr") or "").strip()
+            if base and t:
+                out.setdefault(base, t)
+    return out
+
+
+def main():
+    src = load_sources()
+    print("可用文本来源: %d 条" % len(src))
+    made = have = none = 0
+    for d in sorted(os.listdir(VOICE)):
+        pdir = os.path.join(VOICE, d)
+        if not os.path.isdir(pdir):
+            continue
+        for f in sorted(os.listdir(pdir)):
+            if not f.lower().endswith(".wav"):
+                continue
+            base = os.path.splitext(f)[0]
+            tp = os.path.join(pdir, base + ".txt")
+            if os.path.exists(tp):
+                have += 1
+                continue
+            t = src.get(base.lower())
+            if not t:
+                none += 1
+                continue
+            io.open(tp, "w", encoding="utf-8", newline="\n").write(t + "\n")
+            made += 1
+    print("补了 %d 条，已有 %d 条，没有来源的 %d 条" % (made, have, none))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/program/tools/label_breath_refs.py b/program/tools/label_breath_refs.py
new file mode 100644
index 0000000..1500146
--- /dev/null
+++ b/program/tools/label_breath_refs.py
@@ -0,0 +1,121 @@
+# -*- coding: utf-8 -*-
+"""给「只有呼吸/拟声、没有台词」的参考音频补呼吸型文本。
+
+为什么这么做：H 场景的台词本身大量是拟声（「あ…うっ…はぁ…」），
+参考音频也是拟声时，两者是**匹配**的；问题只在于 prompt_text 不能为空——
+GPT-SoVITS 要靠它切语义 token，空文本等于丢掉了韵律条件。
+
+做法：不用人工编词，按**音频里的实际气口**生成：
+  1. 算 50ms 帧的 RMS 包络；
+  2. 以高分位数为基准取阈值，找出连续的发声段（气口）；
+  3. 每个气口写一个拟声词（短气口用「はぁ」，长的用「あ」），用「…」连接。
+
+这样文本的音节数与气口数一一对应，既不编造台词，也能让韵律条件对上。
+"""
+import io
+import os
+import struct
+import sys
+import wave
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+H = os.path.join(os.path.dirname(_HERE), "build_env", "characters", "和纱", "voice", "H")
+FRAME = 0.05          # 50ms 一帧
+MIN_SEG = 0.18        # 气口最短 0.18s
+MERGE_GAP = 0.25      # 间隔小于 0.25s 的合并成一个气口
+
+
+def rms_envelope(path):
+    with wave.open(path, "rb") as w:
+        sr = w.getframerate()
+        ch = w.getnchannels()
+        sw = w.getsampwidth()
+        raw = w.readframes(w.getnframes())
+    if sw != 2:
+        raise ValueError("只处理 16bit wav: %s" % path)
+    n = len(raw) // 2
+    vals = struct.unpack("<%dh" % n, raw[:n * 2])
+    if ch > 1:
+        vals = vals[::ch]
+    step = max(1, int(sr * FRAME))
+    env = []
+    for i in range(0, len(vals) - step, step):
+        chunk = vals[i:i + step]
+        s = 0
+        for v in chunk:
+            s += v * v
+        env.append((s / len(chunk)) ** 0.5)
+    return env, len(env) * FRAME
+
+
+def segments(path):
+    env, dur = rms_envelope(path)
+    if not env:
+        return [], 0.0
+    srt = sorted(env)
+    p95 = srt[int(len(srt) * 0.95)] or 1
+    thr = max(p95 * 0.18, 120.0)          # 阈值：相对峰值，且不低到抓噪声
+    segs, cur = [], None
+    for i, e in enumerate(env):
+        if e >= thr:
+            if cur is None:
+                cur = [i, i]
+            else:
+                cur[1] = i
+        else:
+            if cur is not None:
+                segs.append(cur)
+                cur = None
+    if cur is not None:
+        segs.append(cur)
+    # 合并过近的气口
+    merged = []
+    for s in segs:
+        if merged and (s[0] - merged[-1][1]) * FRAME < MERGE_GAP:
+            merged[-1][1] = s[1]
+        else:
+            merged.append(list(s))
+    # 过滤太短的
+    out = [(a * FRAME, (b - a + 1) * FRAME) for a, b in merged
+           if (b - a + 1) * FRAME >= MIN_SEG]
+    return out, dur
+
+
+def text_from_segments(segs):
+    parts = []
+    for _, length in segs:
+        parts.append("はぁ" if length <= 0.9 else "あ")
+    if not parts:
+        return ""
+    return "…".join(parts)
+
+
+def main():
+    args = sys.argv[1:]
+    dry = "--dry-run" in args
+    args = [a for a in args if a != "--dry-run"]
+    todo = args or [os.path.splitext(f)[0] for f in sorted(os.listdir(H))
+                            if f.lower().endswith(".wav")
+                            and not os.path.exists(os.path.join(H, os.path.splitext(f)[0] + ".txt"))]
+    print("待处理 %d 条" % len(todo))
+    for base in todo:
+        wav = os.path.join(H, base + ".wav")
+        if not os.path.isfile(wav):
+            print("  缺文件:", base)
+            continue
+        segs, dur = segments(wav)
+        txt = text_from_segments(segs)
+        if not txt:
+            # 一个气口都没抓到：退回一个最朴素的，总比空文本好
+            txt = "はぁ…"
+        if not dry:
+            io.open(os.path.join(H, base + ".txt"), "w", encoding="utf-8",
+                    newline="\n").write(txt + "\n")
+        print("  %-8s %5.1fs  气口 %2d 个  %s" % (base, dur, len(segs), txt[:56]))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/program/tools/merge_short_refs.py b/program/tools/merge_short_refs.py
new file mode 100644
index 0000000..ac5a9a0
--- /dev/null
+++ b/program/tools/merge_short_refs.py
@@ -0,0 +1,138 @@
+# -*- coding: utf-8 -*-
+"""把「太短、单独用不了」的参考音频按连续编号拼成一条。
+
+为什么要拼：GPT-SoVITS 的参考音频最好 3~10 秒、内容是一句完整的话。
+太短的片段（<3 秒，或文本不到 6 个字）单独当参考效果差；但如果编号是连续的
+（ka0301、ka0302、ka0303），它们往往是同一段连着的台词，拼起来就够用了。
+
+做法：
+  · 识别候选：时长 < 最小值（默认 3.0s）或 文本字数 < 最小值（默认 6）；
+  · 只把**编号连续**的相邻候选并成一组（中间缺号就断开）；
+  · 音频拼接：中间补一小段静音（默认 0.25s），采样率/声道/位深必须一致；
+  · 文本拼接：用「、」连接；
+  · 输出 <首号>_<末号>.wav + 同名 .txt，**保留原文件**（不删）。
+  · 合并后超过最大时长（默认 12s）的组跳过 —— 太长做参考反而不好。
+
+    cd program && .\\build_env\\venv\\Scripts\\python.exe tools\\merge_short_refs.py H --dry-run
+    cd program && .\\build_env\\venv\\Scripts\\python.exe tools\\merge_short_refs.py H --apply
+"""
+import io
+import os
+import struct
+import sys
+import wave
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+VOICE = os.path.join(PROGRAM, "build_env", "characters", "和纱", "voice")
+
+MIN_DUR = 3.0        # 短于这个算"太短"
+MIN_CHARS = 6        # 文本短于这个字也算"太短"
+GAP_S = 0.25         # 拼接时的静音间隔
+MAX_MERGED = 12.0    # 合并后超过这个时长就跳过
+
+
+def num_of(base):
+    tail = "".join(ch for ch in base if ch.isdigit())
+    return int(tail) if tail else None
+
+
+def read_wav(path):
+    with wave.open(path, "rb") as w:
+        return {"sr": w.getframerate(), "ch": w.getnchannels(),
+                "sw": w.getsampwidth(), "data": w.readframes(w.getnframes())}
+
+
+def dur_of(path):
+    try:
+        with wave.open(path, "rb") as w:
+            return w.getnframes() / float(w.getframerate())
+    except Exception:
+        return -1.0
+
+
+def main():
+    args = [a for a in sys.argv[1:]]
+    apply = "--apply" in args
+    args = [a for a in args if not a.startswith("--")]
+    folder = args[0] if args else "H"
+    d = os.path.join(VOICE, folder)
+    assert os.path.isdir(d), "目录不存在: %s" % d
+
+    items = []
+    for f in sorted(os.listdir(d)):
+        if not f.lower().endswith(".wav"):
+            continue
+        base = os.path.splitext(f)[0]
+        if "_" in base:          # 已经合并过的不再参与
+            continue
+        tp = os.path.join(d, base + ".txt")
+        txt = ""
+        if os.path.exists(tp):
+            txt = io.open(tp, encoding="utf-8").read().strip()
+        items.append({"base": base, "path": os.path.join(d, f), "txt": txt,
+                      "dur": dur_of(os.path.join(d, f)), "n": num_of(base)})
+
+    shorts = [x for x in items if x["n"] is not None
+              and (x["dur"] < MIN_DUR or len(x["txt"]) < MIN_CHARS)]
+    shorts.sort(key=lambda x: x["n"])
+
+    groups, cur = [], []
+    for x in shorts:
+        if cur and x["n"] == cur[-1]["n"] + 1:
+            cur.append(x)
+        else:
+            if len(cur) >= 2:
+                groups.append(cur)
+            cur = [x]
+    if len(cur) >= 2:
+        groups.append(cur)
+
+    print("=== %s：短片段 %d 个，可拼接的连续组 %d 组 ===" % (folder, len(shorts), len(groups)))
+    made = 0
+    for g in groups:
+        total = sum(x["dur"] for x in g) + GAP_S * (len(g) - 1)
+        text = "、".join(x["txt"] for x in g if x["txt"])
+        name = "%s_%s" % (g[0]["base"], g[-1]["base"])
+        ok = total <= MAX_MERGED and text
+        print("  %-24s %d 条 %5.1fs -> %.1fs  %s%s"
+              % (name, len(g), sum(x["dur"] for x in g), total,
+                 "可合并" if ok else "跳过（太长/无文本）", ""))
+        print("      文本: %s" % text[:70])
+        if not ok or not apply:
+            continue
+        # 拼接
+        first = read_wav(g[0]["path"])
+        sr, ch, sw = first["sr"], first["ch"], first["sw"]
+        frames = []
+        for i, x in enumerate(g):
+            info = read_wav(x["path"])
+            if (info["sr"], info["ch"], info["sw"]) != (sr, ch, sw):
+                print("      参数不一致，跳过：%s" % x["base"])
+                frames = None
+                break
+            frames.append(info["data"])
+        if frames is None:
+            continue
+        gap = b"\x00" * int(sr * GAP_S) * ch * sw
+        out_path = os.path.join(d, name + ".wav")
+        with wave.open(out_path, "wb") as w:
+            w.setnchannels(ch)
+            w.setsampwidth(sw)
+            w.setframerate(sr)
+            for i, fr in enumerate(frames):
+                if i:
+                    w.writeframes(gap)
+                w.writeframes(fr)
+        io.open(os.path.join(d, name + ".txt"), "w", encoding="utf-8",
+                newline="\n").write(text + "\n")
+        made += 1
+
+    print()
+    print(("已合并 %d 组（原文件保留）" % made) if apply else "（--dry-run：没有写文件，加 --apply 才合并）")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/program/tools/ref_cer_rank.py b/program/tools/ref_cer_rank.py
new file mode 100644
index 0000000..cdd49fe
--- /dev/null
+++ b/program/tools/ref_cer_rank.py
@@ -0,0 +1,96 @@
+# -*- coding: utf-8 -*-
+"""给每条参考音频打分：合成两句测试句 → ASR 回读 → 算平均 CER。
+
+为什么这么做：随机抽参考会让质量时好时坏（用户说「偶尔有些实词说不出来」）。
+实测发现不同参考的 CER 差别很大，所以干脆逐条打分，把念不清的排到最后。
+
+    other\\dev\\train\\venv\\Scripts\\python.exe program\\tools\\ref_cer_rank.py H
+"""
+import io
+import json
+import os
+import sys
+import tempfile
+import wave
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+sys.path.insert(0, os.path.join(PROGRAM, "src"))
+os.environ.setdefault("WA2_USER_DIR", os.path.join(PROGRAM, "build_env"))
+
+import tts_client as TC  # noqa: E402
+
+SENTENCES = [
+    "あぁ…ちょっと、指、なら、いいけど…っ、そこは、だめ…",
+    "んっ…そこ、やだ…っ、でも、もっと、して…",
+]
+
+
+def cer(ref, hyp):
+    r, h = list(ref), list(hyp)
+    if not r:
+        return 0.0
+    dp = list(range(len(h) + 1))
+    for i, rc in enumerate(r, 1):
+        prev, dp[0] = dp[0], i
+        for j, hc in enumerate(h, 1):
+            cur = dp[j]
+            dp[j] = min(dp[j] + 1, dp[j - 1] + 1, prev + (rc != hc))
+            prev = cur
+    return dp[len(h)] / len(r)
+
+
+def main():
+    from faster_whisper import WhisperModel
+    folder = sys.argv[1] if len(sys.argv) > 1 else "H"
+    voice = os.path.join(PROGRAM, "build_env", "characters", "和纱", "voice", folder)
+    side = os.path.join(voice, "_refaudio.json")
+    info = {}
+    if os.path.isfile(side):
+        for r in json.loads(io.open(side, encoding="utf-8").read()):
+            info[r["wav"]] = r
+    m = WhisperModel("large-v3", device="cpu", compute_type="int8")
+    TC._ready = True
+
+    cands = []
+    for f, r in sorted(info.items()):
+        if r.get("ratio", 0) < 0.5 or not (3.5 <= r.get("dur", 0) <= 7.5):
+            continue
+        tp = os.path.join(voice, os.path.splitext(f)[0] + ".txt")
+        txt = io.open(tp, encoding="utf-8").read().strip() if os.path.isfile(tp) else ""
+        if not txt or TC._looks_like_moan(txt):
+            continue
+        cands.append((f, txt))
+    print("候选参考 %d 条" % len(cands))
+
+    scores = {}
+    for f, txt in cands:
+        wav = os.path.join(voice, f)
+        cers = []
+        for s in SENTENCES:
+            TC._TTS_CACHE_DIR = tempfile.mkdtemp(prefix="wa2_rank_")
+            TC._ref_cache = {folder.lower(): [(wav, txt)], folder: [(wav, txt)]}
+            TC._refs_sig = TC._char_voice_sig()
+            data = TC.synthesize(s, "ja", emo=folder)
+            if not data:
+                cers.append(1.0)
+                continue
+            p = os.path.join(tempfile.mkdtemp(), "o.wav")
+            io.open(p, "wb").write(data)
+            segs, _ = m.transcribe(p, language="ja", beam_size=1, vad_filter=False,
+                                   condition_on_previous_text=False)
+            hyp = "".join(x.text for x in segs).strip()
+            cers.append(cer(s, hyp))
+        avg = sum(cers) / len(cers)
+        scores[f] = round(avg, 3)
+        print("  %-12s CER %.2f  (%.2f/%.2f)  %s"
+              % (f, avg, cers[0], cers[1], txt[:20]), flush=True)
+        io.open(os.path.join(voice, "_refcer.json"), "w", encoding="utf-8", newline="\n").write(
+            json.dumps(scores, ensure_ascii=False, indent=1))
+    print("\n已写", os.path.join(voice, "_refcer.json"))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/program/tools/ref_vad_scan.py b/program/tools/ref_vad_scan.py
new file mode 100644
index 0000000..19498ce
--- /dev/null
+++ b/program/tools/ref_vad_scan.py
@@ -0,0 +1,79 @@
+# -*- coding: utf-8 -*-
+"""用 VAD 测参考音频里到底有多少「人声」，而不是看文本猜。
+
+问题：我按文本的"实词分"给参考分级，但文本来自 ASR/训练清单，
+      文本写着「いいからそのまま」，音频里可能大部分是喘息 —— 文本骗人。
+办法：silero VAD 直接看音频，算出「有声时间占比」。占比低 = 气声为主，不适合念正常台词。
+
+    other\\dev\\train\\venv\\Scripts\\python.exe program\\tools\\ref_vad_scan.py H
+"""
+import io
+import json
+import os
+import sys
+import wave
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+VOICE = os.path.join(PROGRAM, "build_env", "characters", "和纱", "voice")
+
+
+def dur(path):
+    with wave.open(path, "rb") as w:
+        return w.getnframes() / float(w.getframerate())
+
+
+def main():
+    from faster_whisper.vad import VadOptions, get_speech_timestamps, collect_chunks
+    import numpy as np
+
+    folder = sys.argv[1] if len(sys.argv) > 1 else "H"
+    d = os.path.join(VOICE, folder)
+    out_path = os.path.join(VOICE, folder, "_refaudio.json")
+    print("目录:", d)
+
+    opts = VadOptions(min_silence_duration_ms=250, speech_pad_ms=100)
+    rows = []
+    for f in sorted(os.listdir(d)):
+        if not f.lower().endswith(".wav"):
+            continue
+        p = os.path.join(d, f)
+        try:
+            with wave.open(p, "rb") as w:
+                sr, ch, sw = w.getframerate(), w.getnchannels(), w.getsampwidth()
+                raw = w.readframes(w.getnframes())
+            import array
+            a = array.array("h")
+            a.frombytes(raw)
+            if ch > 1:
+                a = a[::ch]
+            x = np.array(a, dtype=np.float32) / 32768.0
+            if sr != 16000:
+                # 线性插值重采样到 16k（VAD 的时间戳按 16k 算，直接切片会算错时长）
+                n_out = int(len(x) * 16000.0 / sr)
+                idx = np.linspace(0, len(x) - 1, n_out)
+                x = np.interp(idx, np.arange(len(x)), x).astype(np.float32)
+            segs = get_speech_timestamps(x, opts)
+            speech = sum(s["end"] - s["start"] for s in segs) / 16000.0
+        except Exception as e:
+            print("  跳过 %s: %s" % (f, e))
+            continue
+        total = dur(p)
+        rows.append({"wav": f, "dur": round(total, 2),
+                     "speech": round(speech, 2),
+                     "ratio": round(speech / total, 3) if total else 0.0})
+    io.open(out_path, "w", encoding="utf-8", newline="\n").write(
+        json.dumps(rows, ensure_ascii=False, indent=1))
+    rows.sort(key=lambda r: -r["ratio"])
+    print("\n%-12s %6s %7s %7s" % ("文件", "时长", "人声", "占比"))
+    for r in rows:
+        print("%-12s %6.1f %7.1f %7.2f" % (r["wav"], r["dur"], r["speech"], r["ratio"]))
+    n_low = sum(1 for r in rows if r["ratio"] < 0.3)
+    print("\n共 %d 条；人声占比 <0.3 的 %d 条（气声为主）" % (len(rows), n_low))
+    print("已写:", out_path)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
