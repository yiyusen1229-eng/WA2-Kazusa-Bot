@@ -0,0 +1,200 @@
+/* choice.css —— 选择分支（选项条）
+ *
+ * ===========================================================================
+ * 几何量怎么来的（见 other/docs/界面像素测量方法.md）
+ * ---------------------------------------------------------------------------
+ * 参考图：program/work_scratch/orig_game.jpg（原版整帧 2730×1536，含两条选项）。
+ * 换算：800 / 2730 = 0.29304（整帧 → 800×450 舞台）。
+ *
+ * 关键结论：**原版贴图是 1:1 等比缩放，不是三段拉伸**
+ *   sys_00200 每段 784×72；800/1280 = 0.625 = 8/5 是整套 UI 素材的固定缩放
+ *   → 784×0.625 = 490.0，72×0.625 = 45.0
+ *   所以条子就是 490×45，宽高比 10.9:1 和贴图一模一样（上一版写 490×22，
+ *   竖着压掉一半，这是"不像原版"的主因）。
+ *
+ * 实测读数（都用归一化互相关在 800×450 上量的，雪花/条子当模板）：
+ *   条宽 490        条高 45        左端 x=154.7（正好水平居中：(154.7+644.7)/2=399.7）
+ *   第 1 行上沿 y=148，行距 52（雪花模板在 y=148 / y=200 两处命中，score 均 >11）
+ *   贴图可见内容在段内第 5~58 行 → 条身可见 3.1~36.3px（上下各留软边）
+ *   雪花：和第 1/2 段同画布，整张 snow.png 叠上去即可，左朵在条内 x 24.4~58.1
+ *   小白牌：sys_00011 图集 alpha 盒 (219,64)-(236,96) = 18×33 → 11.25×20.625，
+ *          条内 (56, 10.7)，牌心与条子中线齐平
+ *   文字：原版字身格 32px（补丁字模 FONT_OCCUPATION）→ 0.625 后 20px；
+ *        首字墨迹在条内 x≈75.3、行高 20 时 top=11 正好对上（墨迹 y 213~228）
+ *        字距 = 28×0.625 = 17.5px/全角字（原版"把脸背过去"5 字跨 85px，实测吻合）
+ *        编号"1."与正文同一张字模（原版就是同字号全角步进，不是另找的数字图）
+ *   状态：常态 = 段1（半透明淡青）；悬停 = 段2（浓蓝＋亮青顶边）＋字变金
+ *
+ * 素材（都是原版图，`python program/tools/make_choice_assets.py` 生成）：
+ *   bar_off.png / bar_on.png / snow.png ← sys_00200 三段（784×72 各一帧）
+ *   tag.png                            ← sys_00011 图集里那块带别针的小白牌
+ * ===========================================================================
+ */
+
+#choiceScreen {
+  position: absolute;
+  inset: 0;
+  display: none;
+  z-index: 70;
+  opacity: 1;
+  transition: opacity .26s ease;
+  pointer-events: none;
+}
+#choiceScreen.show { display: block; pointer-events: auto; }
+#choiceScreen.in { opacity: 0; }          /* 入场第一帧：压透明，下一帧推到 1 */
+#choiceScreen.fading { opacity: 0; }       /* 点选后整层淡出 */
+
+#choiceList { position: absolute; inset: 0; }
+
+/* 一条 = 条身贴图 + 雪花层 + 小白牌 + 一整张字模（编号+正文） */
+.choiceRow {
+  position: absolute;
+  left: 154.7px;
+  width: 490px;
+  height: 45px;
+  padding: 0;
+  margin: 0;
+  border: 0;
+  display: block;
+  background: none;
+  border-radius: 0;
+  appearance: none;
+  -webkit-appearance: none;
+  cursor: pointer;
+  outline: 0;
+  -webkit-tap-highlight-color: transparent;
+}
+
+/* 条身：整张等比铺满 490×45（不切、不拉伸）。
+   悬停 = **换图**，不是再叠一层：bar_on.png 已经在素材阶段把「段1 + 段2」按加法
+   烘成一张，alpha 和 bar_off.png 逐像素相同，所以轮廓一模一样、结构上不可能接出边。
+   （曾经用 mix-blend-mode: plus-lighter 实时叠：选项层有 z-index，它的混合背景只有
+   条子本身、不含 CG，`α出 = α源+α底` 一夹满这块就变不透明、CG 被顶掉，
+   软边那几行出现最暗 −110 的黑边——就是用户看到的「框线」。） */
+.choiceBg {
+  position: absolute;
+  inset: 0;
+  background-image: url("assets/ui/choice/bar_off.png");
+  background-size: 100% 100%;
+  background-repeat: no-repeat;
+  pointer-events: none;
+}
+.choiceRow:hover .choiceBg,
+.choiceRow.hover .choiceBg {
+  background-image: url("assets/ui/choice/bar_on.png");
+}
+
+/* 悬停时**不要**再给条身加 filter: drop-shadow 做辉光。
+   实测（开/关 filter 各截一张、同一场景逐像素差）：加 drop-shadow 之后，条子soft边外面
+   那几行会**变暗** 5~10 级（R 掉得最多），也是一圈黑边；不加就干净。
+   原版本来也没有额外辉光——它的边缘衰减就是贴图自己的 alpha 坡。 */
+
+/* 两端雪花：和条子同画布同原点，整张叠上去。
+   **也是加法**：雪花贴图芯色 (149,193,227)，原版常态那条的雪花最亮处实测 R = 159，
+   正好等于 149 + 条身底色 ~10；用普通 alpha 盖上去只能得到 149 以下，会发灰
+   （用户反馈「选中的时候雪花没有亮」就是这个）。plus-lighter 之后常态/悬停都跟着
+   底下的条身一起亮，和原版一致。 */
+.choiceSnow {
+  position: absolute;
+  inset: 0;
+  background-image: url("assets/ui/choice/snow.png");
+  background-size: 100% 100%;
+  background-repeat: no-repeat;
+  mix-blend-mode: plus-lighter;
+  pointer-events: none;
+}
+
+/* 选择分支开着的时候把输入栏收起来：输入栏的青色边框正好横穿选项条那一行，
+   会看成一条「分界线」（也点不到，收起来更接近原版只有对话框的样子）。 */
+body.choiceOpen #inputBar { opacity: 0; pointer-events: none; }
+
+/* 但工具栏要留在选项层**上面**：开着选项也要能点「存档」——
+   存下去的这一笔会带上还没选的分支（meta.choice），读回来就摆回原来那几条。
+   工具栏在右下（y≈421），选项条最多排到 y≈401，不会盖住。 */
+body.choiceOpen #toolbar { z-index: 78; }
+
+/* 小白牌（真素材，18×33 × 0.625） */
+.choiceTag {
+  position: absolute;
+  left: 56px;
+  top: 10.7px;
+  width: 11.25px;
+  height: 20.625px;
+  background-image: url("assets/ui/choice/tag.png");
+  background-size: 100% 100%;
+  background-repeat: no-repeat;
+  pointer-events: none;
+}
+
+/* 一整张字模：白字+黑描边（常态）/ 金字+黑描边（悬停），两层叠着做交叉淡入。
+   宽度必须写死：两层 img 都是 position:absolute，不给宽度容器会塌成 0，
+   再被 overflow:hidden 一裁就什么都看不见了（探针里 txtBox 宽 0 就是这个）。 */
+.choiceTxt {
+  position: absolute;
+  left: 74px;
+  top: 11px;
+  width: 400px;
+  height: 20px;
+  overflow: hidden;
+  pointer-events: none;
+  line-height: 0;
+}
+.choiceTxt img {
+  position: absolute;
+  left: 0;
+  top: 0;
+  height: 20px;
+  width: auto;
+  display: block;
+  transition: opacity .14s ease;
+}
+.choiceTxt .txtNormal { opacity: 1; }
+.choiceTxt .txtGold { opacity: 0; }
+.choiceRow:hover .txtNormal,
+.choiceRow.hover .txtNormal { opacity: 0; }
+.choiceRow:hover .txtGold,
+.choiceRow.hover .txtGold { opacity: 1; }
+
+/* 请求还没回来时：按钮进入等待态，别让用户连点 */
+#choiceBtn.busy {
+  opacity: .55 !important;
+  cursor: progress;
+  pointer-events: none;
+}
+
+/* 「选择分支」按钮（和发送键同一张三段底板，位置在输入栏左下） */
+#choiceBtn {
+  position: absolute;
+  bottom: -22px;
+  right: 180px;
+  height: 20px;
+  width: 82px;
+  padding: 0 6px;
+  font-size: 7.6px;
+  letter-spacing: .6px;
+  color: #f4fcff !important;
+  font-family: inherit !important;
+  text-shadow: 0 1px 2px rgba(0, 18, 36, .95) !important;
+  background-color: transparent !important;
+  border: 0 !important;
+  border-radius: 0 !important;
+  box-shadow: none !important;
+  outline: 0 !important;
+  cursor: pointer;
+  isolation: isolate;
+  white-space: nowrap;
+}
+#choiceBtn::before {
+  content: "";
+  position: absolute;
+  left: 0; top: 0; right: 0; bottom: 0;
+  z-index: -1;
+  background-image: url("assets/ui/btn_3state.png");
+  background-size: 100% 300%;
+  background-repeat: no-repeat;
+  background-position: 0 0;
+  opacity: var(--ui-alpha, 1);
+  pointer-events: none;
+}
+#choiceBtn:active::before { background-position: 0 50%; }
+#choiceBtn.released::before { background-position: 0 100%; }
