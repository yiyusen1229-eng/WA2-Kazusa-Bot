+  }
+  WA2.choices = _exp;
+  WA2.register("choices", _exp);
+  /* __export_all__ */
+  ["showChoices", "CHOICE_SETS", "WA2", "_exp", "_names", "b", "list", "set"].forEach(function (n) {
+    try { var v = eval(n); if (v !== undefined) { window[n] = v; } } catch (e) {}
+  });
