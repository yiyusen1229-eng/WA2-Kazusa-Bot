+/* session.js —— 从 game.js 搬出的功能块（逻辑未改）
+ * 挂载：WA2.session；同时同步到 window 以兼容旧调用。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = (WA2.util && WA2.util.$) || function (id) { return document.getElementById(id); };
+
+  function sessionSave() {
+    try {
+      fetch("/api/session/save", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          slot: "auto",
+          messages: (window.__history || history || []),
+          meta: { bg: currentBg || "", outfit: (WA2.state.outfit || ""), at: Date.now() }
+        })
+      }).catch(function () {});
+    } catch (e) {}
+  }
+
+  /* 读档：保持 history 是同一个数组（别的模块持有引用），只换内容 */
+  function applyHistory(arr) {
+    history.length = 0;
+    (arr || []).forEach(function (m) { history.push(m); });
+    window.__history = history;
+  }
+
+  function sessionRestore() {
+    return fetch("/api/session/load?slot=auto", { cache: "no-store" })
+      .then(function (r) { return r.json(); })
+      .then(function (d) {
+        if (!d || !d.ok || !d.messages || !d.messages.length) return false;
+        applyHistory(d.messages);
+        const meta = d.meta || {};
+        if (meta.bg) { currentBg = null; setBg(meta.bg); }
+        if (meta.outfit) { WA2.state.outfit = meta.outfit; }
+        // 把最后一句和纱的话显示出来
+        let last = "";
+        for (let i = history.length - 1; i >= 0; i--) {
+          if (history[i].role === "assistant") { last = history[i].zh || history[i].content || ""; break; }
+        }
+        if (last) {
+          try { showReply(last); } catch (e) { $("msgText").textContent = last; }
+          var _lastJa = "";
+          for (var _i = history.length - 1; _i >= 0; _i--) {
+            if (history[_i].role === "assistant") { _lastJa = history[_i].content || ""; break; }
+          }
+          if (_lastJa) speakLineJa(_lastJa, "calm");
+        }
+        if (meta.outfit) {
+          try { setSpriteByScene(meta.bg || "classroom", "calm", true, meta.outfit); } catch (e) {}
+        }
+        console.log("[session] 已恢复", history.length, "条");
+        try { rebuildBacklog(); } catch (e) {}
+        return true;
+      })
+      .catch(function () { return false; });
+  }
+
+  /* 读档：把存档恢复到当前对话并进入游戏 */
+  window.__loadSession = function (data) {
+    try {
+      applyHistory(data.messages);
+      const meta = data.meta || {};
+      showScreen("gameScreen");
+      titleBgmStarted = true;
+      if (meta.bg) { currentBg = null; setBg(meta.bg); } else { setBg("classroom"); }
+      if (meta.outfit) { WA2.state.outfit = meta.outfit; }
+      setSpriteByScene(meta.bg || "classroom", "calm", true, meta.outfit || "");
+      gdiRenderName(CHAR_NAME, $("namePlate"));
+      setBgm("calm", 600);
+      let last = "";
+      for (let i = history.length - 1; i >= 0; i--) {
+        if (history[i].role === "assistant") { last = history[i].zh || history[i].content || ""; break; }
+      }
+      if (last) {
+        try { showReply(last); } catch (e) { $("msgText").textContent = last; }
+        var _lastJa = "";
+        for (var _i = history.length - 1; _i >= 0; _i--) {
+          if (history[_i].role === "assistant") { _lastJa = history[_i].content || ""; break; }
+        }
+        if (_lastJa) speakLineJa(_lastJa, "calm");
+      }
+      try { rebuildBacklog(); } catch (e) {}
+      setTimeout(function () { $("input").focus(); }, 300);
+    } catch (e) { console.warn("load session failed", e); }
+  };
+
+  /* 存档界面用：取当前会话要写进 meta 的东西（背景 / 立绘）
+     currentBg、currentOutfit 是模块内变量，这里只读不写 */
+  window.__saveMeta = function () {
+    return {
+      bg: (typeof currentBg !== "undefined" && currentBg) || "",
+      outfit: (WA2.state.outfit || ""),
+      at: Date.now()
+    };
+  };
+  /* 存档界面用：按场景名取背景图，给槽位缩略图用 */
+  window.__bgThumb = function (name) { return bgSrc(name); };
+  /* 调试/探针用：直接切到某张场景图（传 CG 的 id，或旧背景名） */
+  window.__scenePreview = function (name) { currentBg = null; setBg(name); return { bg: currentBg, url: bgSrc(name) }; };
+  /* 工具栏提示（快速存档/读档暂未开放时用） */
+  window.__saveHint = function (msg) {
+    var h = document.getElementById("tbHint");
+    if (!h) return;
+    h.textContent = msg;
+    clearTimeout(window.__saveHintTimer);
+    window.__saveHintTimer = setTimeout(function () { h.textContent = ""; }, 1500);
+  };
+
+  /* 存档界面用：把当前画面（背景 CG + 立绘）截成缩略图
+     160x100，和槽位的缩略图框同比例 */
+  window.__grabThumb = function () {
+    try {
+      var W = 160, H = 100;
+      var cv = document.createElement("canvas");
+      cv.width = W; cv.height = H;
+      var g = cv.getContext("2d");
+      g.fillStyle = "#0a1622"; g.fillRect(0, 0, W, H);
+
+      var bg = window.__curBg;
+      if (bg && bg.complete && bg.naturalWidth) {
+        var s = Math.max(W / bg.naturalWidth, H / bg.naturalHeight);
+        var w = bg.naturalWidth * s, h = bg.naturalHeight * s;
+        g.drawImage(bg, (W - w) / 2, (H - h) / 2, w, h);
+      }
+      var stage = document.getElementById("stage");
+      var sp = document.getElementById("sprite");
+      if (stage && sp && sp.naturalWidth) {
+        var sr = stage.getBoundingClientRect();
+        var r = sp.getBoundingClientRect();
+        if (sr.width > 0 && sr.height > 0) {
+          g.drawImage(sp,
+            (r.left - sr.left) / sr.width * W,
+            (r.top - sr.top) / sr.height * H,
+            r.width / sr.width * W,
+            r.height / sr.height * H);
+        }
+      }
+      return cv.toDataURL("image/jpeg", 0.72);
+    } catch (e) { return ""; }
+  };
+
+  /* ---------- 场景切换 ---------- */
+  let currentBg = null;
+  var _exp = {};
+  var _names = ["sessionRestore", "sessionSave"];
+  for (var _i = 0; _i < _names.length; _i++) {
+    try { var _f = eval(_names[_i]); if (typeof _f === "function") { _exp[_names[_i]] = _f; window[_names[_i]] = _f; } } catch (e) {}
+  }
+  WA2.session = _exp;
+  WA2.register("session", _exp);
+  /* __export_all__ */
+  ["sessionRestore", "sessionSave", "W", "WA2", "_exp", "_lastJa", "_names", "bg", "currentBg", "cv", "g", "h", "last", "meta", "r", "s", "sp", "sr", "stage", "w"].forEach(function (n) {
+    try { var v = eval(n); if (v !== undefined) { window[n] = v; } } catch (e) {}
+  });
+})();
diff --git a/program/src/ui/wt-sprite.js b/program/src/ui/wt-sprite.js
new file mode 100644
index 0000000..6db3c23
--- /dev/null
+++ b/program/src/ui/wt-sprite.js
@@ -0,0 +1,152 @@
+/* wt-sprite.js —— 立绘 / 服装 / 表情（从 game.js 搬出）
+ *
+ * 对外（WA2.sprite）：resolveOutfit / outfitOf / spritePath / setSpriteByScene /
+ *                      reload / summary / index（衣服索引）
+ * 兼容老调用：window.setSpriteByScene / resolveOutfit / outfitOf / spritePath /
+ *             __reloadSprites / __spriteSummary 都指到这里
+ *
+ * 衣服名和文件名都是中文：characters/<角色>/portrait/<衣服名>/<表情名>.png
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = (WA2.util && WA2.util.$) || function (id) { return document.getElementById(id); };
+
+  var OUTFIT_BY_SCENE = {
+    classroom: "高中·春秋JK制服",
+    corridor: "高中·春秋JK制服",
+    music: "舞台演出服",       // 练琴 / 演奏
+    stage: "舞台演出服",
+    street: "coda·常服（眼镜）",
+    cafe: "coda·第二套常服",
+    home: "婚后·居家服",
+    night: "睡衣",
+    dress: "礼服",
+    yukata: "和服（浴衣）",
+    winter: "高中·冬装",
+    summer: "高中·夏季JK制服"
+  };
+
+  var SPRITE_INDEX = {};       // 衣服名 -> {code, label, default, emotions, variants}
+  var currentSprite = null;
+
+  function loadIndex(cb) {
+    fetch("/api/character/sprite/index.json", { cache: "no-store" })
+      .then(function (r) { return r.json(); })
+      .then(function (d) {
+        Object.keys(SPRITE_INDEX).forEach(function (k) { delete SPRITE_INDEX[k]; });
+        Object.assign(SPRITE_INDEX, (d && d.outfits) || {});
+        if (cb) cb();
+      })
+      .catch(function () {});
+  }
+  loadIndex(null);
+
+  /* 名字 / 旧编号 / label → index 里的衣服名（合并过的衣服有多个编号，都在 codes 里） */
+  function resolveOutfit(v) {
+    v = (v || "").trim();
+    if (!v) return "";
+    if (SPRITE_INDEX[v]) return v;
+    for (var k in SPRITE_INDEX) {
+      var o = SPRITE_INDEX[k] || {};
+      if (o.code === v || o.label === v) return k;
+      if (o.codes && o.codes.indexOf(v) >= 0) return k;
+    }
+    return "";
+  }
+
+  function outfitOf(scene) {
+    var name = OUTFIT_BY_SCENE[scene];
+    if (name && SPRITE_INDEX[name]) return name;
+    /* 场景表没命中（或这套衣服没有立绘）：优先校服，再退到索引里的第一套 */
+    var keys = Object.keys(SPRITE_INDEX);
+    for (var i = 0; i < keys.length; i++) {
+      var o = SPRITE_INDEX[keys[i]] || {};
+      if (String(o.code || "") === "001") return keys[i];
+    }
+    return keys.length ? keys[0] : "";
+  }
+
+  // 程序情绪 → 立绘情绪（warm 用微笑）
+  var MOOD_TO_EMO = { angry: "angry", sad: "sad", cold: "cold", smile: "smile", warm: "smile" };
+
+  function spritePath(outfit, emotion) {
+    var o = SPRITE_INDEX[outfit];
+    if (!o) return "assets/kaz_cold.png";
+    var emo = emotion ? (MOOD_TO_EMO[emotion] || emotion) : "";
+    var u = function (name) {
+      return "/api/character/sprite/" + encodeURIComponent(outfit) + "/" + encodeURIComponent(name);
+    };
+    if (emo && o.emotions && o.emotions[emo]) return u(o.emotions[emo]);
+    // 该套衣服没有这个情绪 → 退到「认真」，再退到默认
+    if (o.emotions && o.emotions.serious) return u(o.emotions.serious);
+    return u(o.default);
+  }
+
+  /** 按场景切换服装 */
+  function setSpriteByScene(scene, mood, force, wantOutfit) {
+    // 服装以 WA2.state.outfit 为准；只有对话明确换衣服（wantOutfit）才改
+    var cur = (WA2.state && WA2.state.outfit) || "";
+    var outfit = resolveOutfit(wantOutfit) || resolveOutfit(cur) || outfitOf(scene) || "";
+    var key = outfit + "|" + (mood || "");
+    if (currentSprite === key && !force) return;
+    if (WA2.state) WA2.state.outfit = outfit;
+    var sp = $("sprite");
+    if (!sp) return;
+    sp.classList.remove("show");
+    setTimeout(function () {
+      sp.src = spritePath(outfit, mood);
+      sp.classList.add("show");
+      currentSprite = key;
+    }, 180);
+  }
+
+  /* 切换 / 新建角色之后重拉索引，再强制重画一次当前立绘 */
+  function reload(scene, emo) {
+    loadIndex(function () {
+      currentSprite = "";
+      try { setSpriteByScene(scene || "classroom", emo || "", true); } catch (e) {}
+    });
+  }
+
+  function summary() {
+  var outfits = 0, files = 0;
+    for (var k in SPRITE_INDEX) {
+      outfits++;
+      var vs = (SPRITE_INDEX[k] || {}).variants || [];
+      files += vs.length;
+    }
+    return outfits ? (outfits + " 套衣服 · " + files + " 张") : "";
+  }
+
+  WA2.sprite = {
+    resolveOutfit: resolveOutfit,
+    outfitOf: outfitOf,
+    spritePath: spritePath,
+    setSpriteByScene: setSpriteByScene,
+    reload: reload,
+    summary: summary,
+    index: SPRITE_INDEX
+  };
+
+  // 兼容老调用点（game.js / menubar.js 直接用了这些全局名）
+  window.__reloadSprites = function () { reload(window.__curBg || "classroom", window.__lastEmo || ""); };
+  var _exp = {};
+  var _names = ["loadIndex", "outfitOf", "reload", "resolveOutfit", "setSpriteByScene", "spritePath", "summary"];
+  for (var _i = 0; _i < _names.length; _i++) {
+    try { var _f = eval(_names[_i]); if (typeof _f === "function") { _exp[_names[_i]] = _f; window[_names[_i]] = _f; } } catch (e) {}
+  }
+  WA2.sprite = _exp;
+  WA2.register("sprite", _exp);
+  /* __export_all__ */
+  ["loadIndex", "outfitOf", "reload", "resolveOutfit", "setSpriteByScene", "spritePath", "summary", "MOOD_TO_EMO", "OUTFIT_BY_SCENE", "SPRITE_INDEX", "WA2", "_exp", "_names", "cur", "currentSprite", "emo", "key", "keys", "name", "o", "outfit", "outfits", "sp", "u", "vs"].forEach(function (n) {
+    try { var v = eval(n); if (v !== undefined) { window[n] = v; } } catch (e) {}
+  });
+})();
+
+/* 兼容层（必须在 IIFE 之后）：special.js 用 __spriteSummary；面板统计读 WA2.sprite.index */
+(function () {
+  var s = window.WA2 && window.WA2.sprite;
+  if (!s) { return; }
+  s.index = window.SPRITE_INDEX || {};
+  window.__spriteSummary = s.summary || function () { return ""; };
+})();
diff --git a/program/src/ui/wt-text.js b/program/src/ui/wt-text.js
