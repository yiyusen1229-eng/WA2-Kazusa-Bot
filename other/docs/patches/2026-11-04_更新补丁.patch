+  function updatePageCursor() {
+    const cur = pageCursorEl();
+    if (!cur) return;
+    const text = pageTexts[pageIndex] || "";
+    /* 只有「这一段还没打完 → 不能显示」和「还有下一页」两个条件同时不满足才显示 */
+    if (typing || !text || pageIndex >= pageTexts.length - 1) {
+      cur.style.display = "none";
+      return;
