+    ["继续练琴吧", "陪我走一段"],
+  ];
+
+  function showChoices() {
+    const set = CHOICE_SETS[Math.floor(Math.random() * CHOICE_SETS.length)];
+    const list = $("choiceList");
+    list.innerHTML = "";
