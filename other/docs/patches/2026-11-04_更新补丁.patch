+      if (a === "qload") { if (window.__saveHint) window.__saveHint("快速读档暂未开放"); return; }
+          if (a === "config") { window.__openOptions && window.__openOptions(); return; }
+      if (a === "rew")   toggleBacklog(true);          // 浏览本次对话历史
+      if (a === "close") {
+        /* 右下角那个 ✕ = 隐藏窗口（只留 CG 与立绘），和右键「隐藏窗口」同一套；
