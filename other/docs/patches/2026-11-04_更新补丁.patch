+/* wt-core.js —— 前端共享命名空间（拆分第 1 步，只加不改行为）
+ *
+ * 以后每个功能一个文件，都挂到 WA2 下面：
+ *     WA2.util     公共小函数（$ / on / clamp…）
+ *     WA2.state    跨文件共享的运行时状态（当前角色、当前衣服、音量…）
+ *     WA2.chat     对话：请求 / 解析 / 打字机      （待拆）
+ *     WA2.sprite   立绘 / 服装 / 场景              （待拆）
+ *     WA2.backlog  回想 / 历史                     （待拆）
+ *     WA2.audio    BGM / SE / 语音音量             （待拆）
+ *
+ * 规矩：
+ *   1. 新文件只“往 WA2 上加属性”，不改别人的、不覆盖别人的；
+ *   2. index.html 里 wt-core.js 必须最先加载；
+ *   3. 旧的 IIFE 可以继续用自己的私有变量，等搬完再删；
+ *   4. 每个功能文件用 WA2.register("名字", 对象) 登记自己，便于探针检查。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+
+  WA2.version = "2026-11-04";
+
+  /* 公共小函数：以后各文件别再各写一份 */
+  WA2.util = WA2.util || {
+    $: function (id) { return document.getElementById(id); },
+    $$: function (sel, root) {
+      return Array.prototype.slice.call((root || document).querySelectorAll(sel));
+    },
+    on: function (el, ev, fn, opt) {
+      if (el) el.addEventListener(ev, fn, opt);
+      return el;
+    },
+    clamp: function (v, a, b) { return v < a ? a : (v > b ? b : v); },
+    pad2: function (n) { return (n < 10 ? "0" : "") + n; },
+    isNum: function (v) { return typeof v === "number" && isFinite(v); }
+  };
+
+  /* 跨文件共享状态：只放“多个文件都要读”的东西 */
+  WA2.state = WA2.state || {
+    character: null,     // 当前角色 id（切换后由 special.js 更新）
+    outfit: "",          // 当前衣服名
+    emotion: "calm",     // 当前表情
+    scene: "",           // 当前场景
+    volume: { bgm: 100, voice: 100, se: 100 }
+  };
+
+  /* 功能模块登记处：探针靠它检查“拆出来的文件到底加载了没” */
+  WA2.features = WA2.features || {};
+  WA2.register = function (name, obj) {
+    WA2.features[name] = obj || true;
+    WA2[name] = obj || WA2[name];
+  };
+
+  /* DOM 就绪（各文件都可用，省得各自写一遍） */
+  WA2.ready = function (fn) {
+    if (document.readyState === "loading") {
+      document.addEventListener("DOMContentLoaded", fn);
+    } else {
+      fn();
+    }
+  };
+
+  /* 给控制台/探针一个一眼能看的状态摘要 */
+  WA2.summary = function () {
+    return {
+      version: WA2.version,
+      features: Object.keys(WA2.features),
+      state: WA2.state,
+      ready: document.readyState
+    };
+  };
+})();
diff --git a/program/src/ui/wt-cost.js b/program/src/ui/wt-cost.js
new file mode 100644
index 0000000..02fa840
--- /dev/null
+++ b/program/src/ui/wt-cost.js
@@ -0,0 +1,153 @@
+/* cost.js —— 从 game.js 搬出的功能块（逻辑未改）
+ * 挂载：WA2.cost；同时同步到 window 以兼容旧调用。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = (WA2.util && WA2.util.$) || function (id) { return document.getElementById(id); };
+
+  function costNum(el, str) {
+    if (!el) return;
+    if (el.dataset.v === str && el.children.length) return;
+    el.dataset.v = str;
+    var html = "";
+    for (var i = 0; i < str.length; i++) {
+      var ch = str.charAt(i);
+      var key = (ch === ".") ? "cost_dot" : ("cost_d" + ch);
+      html += '<img src="assets/ui/text/' + key + '.png" alt="' + ch + '">';
+    }
+    el.innerHTML = html;
+    /* 字模图缺失时退回文字，至少能看到数字 */
+    var imgs = el.querySelectorAll("img");
+    for (var j = 0; j < imgs.length; j++) {
+      (function (img, c) {
+        img.addEventListener("error", function () {
+          if (!el.dataset.plain) {
+            el.dataset.plain = "1";
+            el.style.fontSize = "11px";
+            el.style.color = "#cfe9f5";
+            el.style.lineHeight = "12px";
+            el.textContent = str;
+          }
+        });
+      })(imgs[j], str);
+    }
+  }
+
+  /* 金额转成"纯数字串"（币种符号已经是一张固定的 ¥ 图） */
+  function moneyStr(v) {
+    v = Number(v) || 0;
+    if (v === 0) return "0";
+    if (v < 0.01) return v.toFixed(6);
+    if (v < 1) return v.toFixed(4);
+    return v.toFixed(3);
+  }
+
+  function renderCost(u) {
+    if (!u) return;
+    /* 每次渲染前重新确认元素（拆分后元素可能比脚本晚出现） */
+    try { bindCostEls(); } catch (e) {}
+    if (u.tokens !== undefined) {
+      costNum(COST_EL.nowT, String(Math.round(u.tokens)));
+      costNum(COST_EL.nowC, moneyStr(u.cost));
+    }
+    costNum(COST_EL.totT, String(Math.round(u.cumTokens || 0)));
+    costNum(COST_EL.totC, moneyStr(u.cumCost));
+  }
+  /* 只刷新累计（程序启动时、以及后台总结之后） */
+  window.__refreshCost = function () {
+    try {
+      fetch("/api/usage", { cache: "no-store" })
+        .then(function (r) { return r.json(); })
+        .then(function (d) {
+          if (d && d.ok) renderCost({ cumTokens: d.tokens, cumCost: d.cost });
+        })
+        .catch(function () {});
+    } catch (e) {}
+  };
+
+  /* 绑定四个数字容器；元素还没出来就下次调用时再绑（拆分后这类时序更脆弱） */
+  function bindCostEls() {
+    if (COST_EL.totT && COST_EL.totC && COST_EL.nowT && COST_EL.nowC) return true;
+    COST_EL.nowT = document.getElementById("costNowT");
+    COST_EL.nowC = document.getElementById("costNowC");
+    COST_EL.totT = document.getElementById("costTotalT");
+    COST_EL.totC = document.getElementById("costTotalC");
+    return !!(COST_EL.totT && COST_EL.totC);
+  }
+
+  function refresh() {
+    bindCostEls();
+    try { window.__refreshCost(); } catch (e) {}
+  }
+
+  window.__renderCost = renderCost;
+  window.__bindCost = bindCostEls;
+  window.__refreshCostNow = refresh;
+
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", function () {
+      refresh();
+      setInterval(refresh, 20000);
+    });
+  } else {
+    refresh();
+    setInterval(refresh, 20000);
+  }
+
+  /* 隐藏窗口后，左键点一下画面就恢复 ——
+     此时 UI 全是 pointer-events:none，点事件落在底层元素上，所以监听在 document 捕获阶段。
+     右键不走这里（交给上面的 contextmenu，避免"恢复界面"和"右键功能"同时触发）。 */
+  document.addEventListener("click", function (e) {
+    if (!document.body.classList.contains("uiHidden")) return;
+    document.body.classList.remove("uiHidden");
+    e.preventDefault();
+    e.stopPropagation();   /* 只负责"叫回界面"，不要顺带翻页 */
+  }, true);
+
+  /* 隐藏界面：只留背景与立绘
+     注意选择器必须对得上真实 ID：#menubar / .dialogBox / #quickBar 这三个在 DOM 里根本不存在
+     （菜单栏是 #menuBar，对话框是 #msgWrap），所以之前「隐藏窗口」只隐藏了底部工具栏。 */
+  (function () {
+    var css = document.createElement("style");
+    css.textContent =
+      "body.uiHidden #msgWrap,body.uiHidden #inputBar,body.uiHidden #toolbar," +
+      "body.uiHidden #menuBar,body.uiHidden #glowBottom,body.uiHidden #historyPanel," +
+      "body.uiHidden #thinkBox,body.uiHidden #choiceScreen,body.uiHidden #costBar," +
+      "body.uiHidden .uiScreen," +
+      "body.uiHidden #dbgPanel{" +
+      "opacity:0!important;pointer-events:none!important}";
+    document.head.appendChild(css);
+  })();
+
+  /* ---------- 角色名：存在 char/name.txt，特别模式里改的就是它 ---------- */
+  window.__setCharName = function (n) {
+    if (!n) return;
+    CHAR_NAME = n;
+    window.__charName = n;
+  var el = document.getElementById("namePlate");
+    if (el && typeof gdiRenderName === "function") gdiRenderName(n, el);
+    // 输入框占位符等跟着名字变（uitext.js 监听）
+    try {
+      document.dispatchEvent(new CustomEvent("wa2:charname", { detail: n }));
+    } catch (e) {}
+  };
+  fetch("/api/special/name", { cache: "no-store" })
+    .then(function (r) { return r.json(); })
+    .then(function (d) { if (d && d.ok && d.name) window.__setCharName(d.name); })
+    .catch(function () {});
+
+
+  /* ---------- 启动默认全屏 ---------- */
+  var _exp = {};
+  var _names = ["costNum", "moneyStr", "renderCost"];
+  for (var _i = 0; _i < _names.length; _i++) {
+    try { var _f = eval(_names[_i]); if (typeof _f === "function") { _exp[_names[_i]] = _f; window[_names[_i]] = _f; } } catch (e) {}
+  }
+  WA2.cost = _exp;
+  WA2.register("cost", _exp);
+  if (WA2.cost) WA2.cost.render = renderCost;
+  /* __export_all__ */
+  ["costNum", "moneyStr", "renderCost", "WA2", "_exp", "_names", "ch", "css", "el", "html", "key"].forEach(function (n) {
+    try { var v = eval(n); if (v !== undefined) { window[n] = v; } } catch (e) {}
+  });
+})();
diff --git a/program/src/ui/wt-gdi.js b/program/src/ui/wt-gdi.js
new file mode 100644
index 0000000..6d85a5c
--- /dev/null
+++ b/program/src/ui/wt-gdi.js
@@ -0,0 +1,59 @@
+/* gdi.js —— 从 game.js 搬出的功能块（逻辑未改）
+ * 挂载：WA2.gdi；同时同步到 window 以兼容旧调用。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = (WA2.util && WA2.util.$) || function (id) { return document.getElementById(id); };
+
+  function gdiRenderName(name, el) {
+    if (!el || window.__gdiOK === false) return;
+    gdiRenderMsg(name, el, 52, 360, 1).then((ok) => {
+      if (!ok) return;
+      el.classList.add("gdi");
+      const im = el.querySelector("img");
+      if (im) im.style.width = (im.naturalWidth * TEXT_SCALE * NAME_BOOST).toFixed(1) + "px";
+    });
+  }
+
+  const TEXT_VER = "1029strict";  // 每次打包更新, 强制浏览器重新取图
+  const GDI_SCALE = 0.625;  // 默认显示比例, 实际用 TEXT_SCALE (Ctrl +/- 可调)
+  let TEXT_SCALE = parseFloat(localStorage.getItem("app_textScale") || "0.625");
+  if (!(TEXT_SCALE > 0.2 && TEXT_SCALE < 3)) TEXT_SCALE = 0.6;
+  function gdiRenderMsg(text, el, size, maxw, emb) {
+    // 服务端 GDI 渲染(微软雅黑) -> 图片, 稳定可靠
+    return __gdiFallback(text, el, size || 28, maxw || 832, emb === undefined ? 0 : emb);
+  }
+
+  function __gdiFallback(text, el, size, maxw, emb) {
+    size = size || 56; maxw = maxw || 1200; emb = (emb === undefined ? 0 : emb);
+    const url = "/api/text?text=" + encodeURIComponent(text) +
+                "&s=" + size + "&w=" + maxw + "&e=" + emb + "&v=" + TEXT_VER;
+    return new Promise((resolve) => {
+      const img = new Image();
+      img.onload = () => {
+        el.innerHTML = "";
+        el.appendChild(img);
+        img.style.cssText = "display:block;width:" + (img.naturalWidth * TEXT_SCALE).toFixed(1) +
+                            "px;height:auto;image-rendering:auto;";
+        resolve(true);
+      };
+      img.onerror = () => resolve(false);
+      img.src = url;
+    });
+  }
+
+
+  /* ---------- 语音 ---------- */
+  let ttsOn = (localStorage.getItem("app_tts") || "1") === "1";
+  var _exp = {};
+  var _names = ["__gdiFallback", "gdiRenderMsg", "gdiRenderName"];
+  for (var _i = 0; _i < _names.length; _i++) {
+    try { var _f = eval(_names[_i]); if (typeof _f === "function") { _exp[_names[_i]] = _f; window[_names[_i]] = _f; } } catch (e) {}
+  }
+  WA2.gdi = _exp;
+  WA2.register("gdi", _exp);
+  /* __export_all__ */
+  ["__gdiFallback", "gdiRenderMsg", "gdiRenderName", "GDI_SCALE", "TEXT_SCALE", "TEXT_VER", "WA2", "_exp", "_names", "im", "img", "ttsOn", "url"].forEach(function (n) {
+    try { var v = eval(n); if (v !== undefined) { window[n] = v; } } catch (e) {}
+  });
+})();
diff --git a/program/src/ui/wt-mood.js b/program/src/ui/wt-mood.js
new file mode 100644
index 0000000..ad4fd0e
--- /dev/null
+++ b/program/src/ui/wt-mood.js
@@ -0,0 +1,76 @@
+/* mood.js —— 从 game.js 搬出的功能块（逻辑未改）
+ * 挂载：WA2.mood；同时同步到 window 以兼容旧调用。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = (WA2.util && WA2.util.$) || function (id) { return document.getElementById(id); };
+
+  function detectMood(text) {
+    const t = text || "";
+    if (/滚|烦|吵|闭嘴|笨蛋|无聊|别管|哼|少来|自作多情/.test(t)) return "angry";
+    if (/抱歉|对不起|哭|寂寞|后悔|离开|再见|讨厌我/.test(t)) return "sad";
+    if (/早点睡|注意|吃药|别勉强|你也|小心|累了吧|照顾好/.test(t)) return "warm";
+    if (/呵|笑|有趣|真拿你没办法|好吧/.test(t)) return "smile";
+    if (/……|没事|没什么|有事|随便|不知道/.test(t)) return "calm";
+    return "calm";
+  }
+
+  const MOOD_BGM = { angry: "tense", sad: "sad", warm: "warm", smile: "warm", cold: "calm" };
+  const MOOD_SPRITE = { angry: "angry", sad: "sad", warm: "school", smile: "smile", cold: "cold" };
+
+  /* ---------- 氛围累积（BGM 不随单句变化） ---------- */
+  const moodScore = { calm: 0, warm: 0, sad: 0, tense: 0 };
+  let moodStable = { name: "calm", turns: 0 };
+
+  function accumulateMood(reply) {
+    const mood = detectMood(reply);
+    const bgm = MOOD_BGM[mood] || "calm";
+    // 每轮衰减，越近的话权重越大
+    for (const k in moodScore) moodScore[k] *= 0.65;
+    moodScore[bgm] = (moodScore[bgm] || 0) + 2;
+    // 长句、强烈情绪加权
+    if (reply.length > 40) moodScore[bgm] += 0.8;
+    if (/[！!]{2,}|滚|闭嘴|笨蛋/.test(reply)) moodScore.tense += 1.2;
+    if (/[（(]笑|呵|真拿你|好吧/.test(reply)) moodScore.warm += 0.8;
+
+    // 当前氛围的分数
+    let best = "calm", bestV = -1;
+    for (const k in moodScore) {
+      if (moodScore[k] > bestV) { bestV = moodScore[k]; best = k; }
+    }
+    const curV = moodScore[currentBgmMood()] || 0;
+
+    // 需要连续两轮领先 2 分以上才切换
+    if (best !== moodStable.name) {
+      moodStable = { name: best, turns: 1 };
+    } else {
+      moodStable.turns++;
+    }
+    const enough = bestV - curV >= 2.0 && moodStable.turns >= 2;
+    if (best !== currentBgmMood() && enough) {
+      setBgm(best);
+    }
+  }
+
+  function currentBgmMood() {
+    for (const k in MOOD_BGM) {
+      if (MOOD_BGM[k] === WA2.audio.current) return k === "smile" ? "warm" : MOOD_BGM[k];
+    }
+    return WA2.audio.current || "calm";
+  }
+
+
+  /* 合并版：按当前角色给开场白 */
+  var OPENING_LINE = { zh: "「……」", ja: "", emo: "calm" };
+  var _exp = {};
+  var _names = ["accumulateMood", "currentBgmMood", "detectMood"];
+  for (var _i = 0; _i < _names.length; _i++) {
+    try { var _f = eval(_names[_i]); if (typeof _f === "function") { _exp[_names[_i]] = _f; window[_names[_i]] = _f; } } catch (e) {}
+  }
+  WA2.mood = _exp;
+  WA2.register("mood", _exp);
+  /* __export_all__ */
+  ["accumulateMood", "currentBgmMood", "detectMood", "MOOD_BGM", "MOOD_SPRITE", "OPENING_LINE", "WA2", "_exp", "_names", "best", "bgm", "curV", "enough", "mood", "moodScore", "moodStable", "t"].forEach(function (n) {
+    try { var v = eval(n); if (v !== undefined) { window[n] = v; } } catch (e) {}
+  });
+})();
diff --git a/program/src/ui/wt-nav.js b/program/src/ui/wt-nav.js
new file mode 100644
index 0000000..a920fed
--- /dev/null
+++ b/program/src/ui/wt-nav.js
@@ -0,0 +1,255 @@
+/* nav.js —— 从 game.js 搬出的功能块（逻辑未改）
+ * 挂载：WA2.nav；同时同步到 window 以兼容旧调用。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = (WA2.util && WA2.util.$) || function (id) { return document.getElementById(id); };
+
+  function playTitleBgm() {
+    if (titleBgmStarted) return;
+    titleBgmStarted = true;
+    setBgm("menu", 400);
+  }
+  document.addEventListener("pointerdown", function once(e) {
+    if ($("titleScreen").classList.contains("active")) playTitleBgm();
+  }, { once: false });
+
+  /* ---------- 菜单 ---------- */
+  /* 结束游戏：先确认，再依次尝试 pywebview 桥接 → HTTP → window.close。
+     （WebView2 里裸 window.close() 不一定关得掉，这是原来点了没反应的原因） */
+  function quitGame(skipConfirm) {
+    let yes = true;
+    if (!skipConfirm) {
+      try { yes = window.confirm("要结束游戏吗？"); } catch (e) { yes = true; }
+    }
+    /* 只有明确点了“取消”才不关；confirm 不可用（返回 undefined）时按继续处理 */
+    if (yes === false) return false;
+    try {
+      if (window.pywebview && window.pywebview.api && window.pywebview.api.win) {
+        window.pywebview.api.win("close");
+      }
+    } catch (e) {}
+    try { fetch("/api/window?action=close", { cache: "no-store" }); } catch (e) {}
+    setTimeout(function () { try { window.close(); } catch (e) {} }, 120);
+    return true;
+  }
+  $("mainMenu").addEventListener("click", (e) => {
+    const btn = e.target.closest("button");
+    if (!btn) return;
+    playSE("click");
+    const act = btn.dataset.act;
+    if (act === "quit") {
+      /* 结束游戏：pywebview 里 window.close() 不一定生效，优先走桥接 / HTTP 关窗口 */
+      quitGame();
+      return;
+    }
+          if (act === "continue") {
+            if (window.__openScreen) window.__openScreen("save", "load");
+            return;
+          }
+          if (act === "config") { if (window.__openOptions) window.__openOptions(); return; }
+          if (act === "special") { if (window.__openSpecial) window.__openSpecial(); return; }
+
+      /* 进游戏前关掉所有浮层（统一走 screens.js，别在这里各自 remove("show")） */
+    if (window.__closeScreens) window.__closeScreens();
+    showScreen("gameScreen");
+    titleBgmStarted = true;
+    setBg("classroom");
+    setSpriteByScene("classroom", "calm", true);
+    gdiRenderName(CHAR_NAME, $("namePlate"));
+    setBgm("calm", 600);
+    if (window.__wantRestore) {
+      window.__wantRestore = false;
+    sessionRestore().then(function (ok) {
+        if (!ok) setTimeout(() => { var _o = openingLine(); typewriter(_o.zh); speakLineJa(_o.ja, _o.emo); }, 200);
+      });
+    } else {
+      // 开始游戏 = 新对话：清空历史与自动存档
+      history = [];
+      try { rebuildBacklog(); } catch (e) {}   /* 新游戏：回想清空 */
+      try {
+        fetch("/api/session/save", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ slot: "auto", messages: [], meta: {} })
+        }).catch(function () {});
+      } catch (e) {}
+      setTimeout(() => { var _o = openingLine(); typewriter(_o.zh); speakLineJa(_o.ja, _o.emo); }, 460);
+    }
+    setTimeout(() => $("input").focus(), 700);
+  });
+
+  $("mainMenu").addEventListener("mouseover", (e) => {
+    if (e.target.closest("button")) playSE("hover");
+  });
+
+  (function () {
+    const b = $("cfgBtn");
+    if (b) b.addEventListener("click", () => {
+      playSE("click");
+      if (window.__openScreen) window.__openScreen("opt");
+    });
+  })();
+
+  ($("sendBtn")||{addEventListener:function(){}}).addEventListener("click", send);
