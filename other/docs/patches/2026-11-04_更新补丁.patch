+      cur.id = "pageCursor";
+      box.appendChild(cur);
+    } else if (cur.parentNode !== box) {
+      box.appendChild(cur);          /* 每次重渲染 msgText 都会被清空，补回来 */
+    }
+    return cur;
+  }
