+          if (!d || !d.ok) { flash((d && d.error) || "打不开文件夹"); return; }
+          if (d.source === "empty") flash("还没有默认文件，先导入一份");
+        })
+        .catch(function () { flash("打不开文件夹"); });
+    }
+
+    function bindFrames() {
+      var items = document.querySelectorAll("#specialScreen .spItem");
+      for (var i = 0; i < items.length; i++) {
+        (function (item) {
