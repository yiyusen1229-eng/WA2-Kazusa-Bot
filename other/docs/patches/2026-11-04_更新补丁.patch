+      const b = document.createElement("button");
+      b.className = "choice";
+      b.textContent = txt;
+      b.addEventListener("mouseenter", () => playSE("hover"));
+      b.addEventListener("click", () => {
+        playSE("click");
+        $("choiceScreen").classList.remove("show");
