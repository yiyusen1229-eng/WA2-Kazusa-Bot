diff --git a/program/src/ui/wt-fade.js b/program/src/ui/wt-fade.js
new file mode 100644
index 0000000..8dc131f
--- /dev/null
+++ b/program/src/ui/wt-fade.js
@@ -0,0 +1,230 @@
+/* wt-fade.js —— 双缓冲交叉淡化（场景背景 / 立绘）
+ *
+ * 以前换背景是「先压到 0.25、等 260ms 再换图」，中间会黑一下；
+ * 立绘则是先藏起来、180ms 后再显示，同样有一瞬间空场。
+ * 双缓冲 = 新旧两张同时在场：新的淡入、旧的留在底下，看起来是「化过去」而不是「闪一下」。
+ *
+ * 对外（WA2.fade）：
+ *   enabled()                过渡开不开（prefs.xfade === false 就关，默认开）
+ *   ms()                     时长（prefs.xfadeMs → performance.json 的 fade_ms → 240，夹 200~300）
+ *   set(on, ms)              改设置（写进 prefs，跟着设置文件持久化）
+ *   crossBg(url, ok, fail)   场景背景：图先预载，载完再淡
+ *   crossSprite(url, ok, fail) 立绘：新图叠一层淡入，淡完再把主图换掉
+ *   describe()               当前设置的快照（调试面板用）
+ *
+ * 关掉过渡时两个函数都退化成「立刻换」，不再有任何动画。
+ * 这个文件不碰 DOM 也能加载（自测里用 Node 跑）：所有 getElementById 都在函数里。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+  var $ = function (id) {
+    return (typeof document !== "undefined" && document.getElementById) ? document.getElementById(id) : null;
+  };
+
+  var DEF_MS = 240;
+  var MIN_MS = 200;
+  var MAX_MS = 300;
+
+  var seqBg = 0;     /* 每次新背景过渡 +1：旧的收尾回调据此作废 */
+  var seqSpr = 0;    /* 立绘单独一套序号 */
+  var front = 0;     /* 0 = #bgLayer 在前（不透明），1 = #bgLayer2 在前 */
+
+  function prefs() {
+    return (window.App && window.App.getPrefs) ? (window.App.getPrefs() || {}) : {};
+  }
+
+  function enabled() {
+    var P = prefs();
+    return P.xfade !== false;          /* 只有显式 false 才关：老设置文件里没有这个键 */
+  }
+
+  /* #19：每角色的 performance.json 里可以给 fade_ms；prefs.xfadeMs 仍然优先（用户自己调过） */
+  function cfgMs() {
+    try {
+      if (window.WA2 && window.WA2.perfCfg && typeof window.WA2.perfCfg.fadeMs === "function") {
+        var v = window.WA2.perfCfg.fadeMs();
+        if (isFinite(v) && v > 0) return v;
+      }
+    } catch (e) {}
+    return DEF_MS;
+  }
+
+  function ms() {
+    var v = Number(prefs().xfadeMs);
+    if (!isFinite(v) || v <= 0) v = cfgMs();       /* 没设 → 角色配置 → 内置默认 */
+    return Math.max(MIN_MS, Math.min(MAX_MS, Math.round(v)));
+  }
+
+  function set(on, msVal) {
+    try {
+      if (window.App && window.App.setPref) {
+        window.App.setPref("xfade", !!on);
+        if (msVal !== undefined && msVal !== null) {
+          var v = Number(msVal);
+          if (isFinite(v) && v > 0) {
+            window.App.setPref("xfadeMs", Math.max(MIN_MS, Math.min(MAX_MS, Math.round(v))));
+          }
+        }
+      }
+    } catch (e) {}
+  }
+
+  function describe() {
+    return { enabled: enabled(), ms: ms(), front: front };
+  }
+
+  /* ---------- 背景 ---------- */
+
+  /** #bgLayer 永远保持「当前这张图」：过渡结束后把图搬回去，别的代码读它不会读到旧值 */
+  function settle(url) {
+    var a = $("bgLayer"), b = $("bgLayer2");
+    if (!a || !url) return;
+    if (b) {
+      b.style.transition = "none";
+      b.style.opacity = "0";
+      b.style.backgroundImage = "none";
+    }
+    a.style.transition = "none";
+    a.style.backgroundImage = 'url("' + url + '")';
+    a.style.opacity = "1";
+    front = 0;
+  }
+
+  function paintBg(a, b, url, my) {
+    var on = enabled() && !!b;
+    var t = ms();
+    a.style.backgroundColor = "";            /* 有图了就把缺图时的兜底底色清掉 */
+
+    if (!on) {
+      if (b) {
+        b.style.transition = "none";
+        b.style.opacity = "0";
+        b.style.backgroundImage = "none";
+      }
+      a.style.transition = "none";
+      a.style.backgroundImage = 'url("' + url + '")';
+      a.style.opacity = "1";
+      front = 0;
+      return;
+    }
+
+    var from = front === 0 ? a : b;
+    var to = front === 0 ? b : a;
+    /* 目标层：先换图、压到 0，强制一次重排，再放开过渡。
+       不加这一步，浏览器会把「0 → 1」合并成一帧，看着还是硬切。 */
+    to.style.transition = "none";
+    to.style.opacity = "0";
+    to.style.backgroundImage = 'url("' + url + '")';
+    to.style.backgroundColor = "";
+    void to.offsetWidth;
+    to.style.transition = "opacity " + t + "ms linear";
+    from.style.transition = "opacity " + t + "ms linear";
+    to.style.opacity = "1";
+    from.style.opacity = "0";
+    front = 1 - front;
+
+    setTimeout(function () {
+      if (my !== seqBg) return;              /* 期间又换了一张：这次收尾作废 */
+      settle(url);
+    }, t + 40);
+  }
+
+  function crossBg(url, ok, fail) {
+    var a = $("bgLayer"), b = $("bgLayer2");
+    if (!a || !url) { if (fail) fail(); return false; }
+    var my = ++seqBg;
+    if (typeof Image === "undefined") { paintBg(a, b, url, my); if (ok) ok(); return true; }
+    var probe = new Image();
+    probe.onload = function () {
+      if (my !== seqBg) return;
+      paintBg(a, b, url, my);
+      if (ok) ok();
+    };
+    probe.onerror = function () { if (my === seqBg && fail) fail(); };
+    probe.src = url;
+    return true;
+  }
+
+  /* ---------- 立绘 ---------- */
+
+  function ghost(wrap) {
+    var g = document.getElementById("spriteGhost");
+    if (!g) {
+      g = document.createElement("img");
+      g.id = "spriteGhost";
+      g.className = "spriteGhost";
+      g.alt = "";
+      wrap.appendChild(g);
+    }
+    return g;
+  }
+
+  /* 叠层淡完之后把主图换掉：本来就是同一张图，看不出切换 */
+  function applySprite(cur, url) {
+    if (cur.classList && cur.classList.contains("show")) {
+      cur.src = url;
+      return;
+    }
+    /* 主图本来就藏着（刚进对话 / 刚切角色）：直接显示，别和叠层抢那 0.6s */
+    cur.style.transition = "none";
+    cur.src = url;
+    if (cur.classList) cur.classList.add("show");
+    void cur.offsetWidth;
+    cur.style.transition = "";
+  }
+
+  function crossSprite(url, ok, fail) {
+    var cur = $("sprite"), wrap = $("spriteWrap");
+    if (!cur || !url) { if (fail) fail(); return false; }
+    var my = ++seqSpr;
+    if (typeof Image === "undefined") {
+      applySprite(cur, url);
+      if (ok) ok();
+      return true;
+    }
+    var probe = new Image();
+    probe.onload = function () {
+      if (my !== seqSpr) return;
+      if (!enabled() || !wrap) {                 /* 关过渡 / 没有容器：立刻换 */
+        applySprite(cur, url);
+        if (ok) ok();
+        return;
+      }
+      var t = ms();
+      var g = ghost(wrap);
+      g.src = url;
+      g.style.transition = "none";
+      g.style.opacity = "0";
+      void g.offsetWidth;
+      g.style.transition = "opacity " + t + "ms linear";
+      g.style.opacity = "1";
+      setTimeout(function () {
+        if (my !== seqSpr) return;
+        applySprite(cur, url);
+        g.style.transition = "none";
+        g.style.opacity = "0";
+        if (ok) ok();
+      }, t + 40);
+    };
+    probe.onerror = function () { if (my === seqSpr && fail) fail(); };
+    probe.src = url;
+    return true;
+  }
+
+  var api = {
+    enabled: enabled,
+    ms: ms,
+    set: set,
+    crossBg: crossBg,
+    crossSprite: crossSprite,
+    settle: settle,
+    describe: describe,
+    DEF_MS: DEF_MS,
+    MIN_MS: MIN_MS,
+    MAX_MS: MAX_MS
+  };
+
+  WA2.fade = api;
+  window.__fade = api;
+  if (WA2.register) WA2.register("fade", api);
+})();
diff --git a/program/src/ui/wt-hotreload.js b/program/src/ui/wt-hotreload.js
new file mode 100644
index 0000000..3facab3
--- /dev/null
+++ b/program/src/ui/wt-hotreload.js
@@ -0,0 +1,97 @@
+/* 素材热重载（#20）：每几秒问一次后端「素材变了吗」，变了就把画面刷新一遍。
+ *
+ * 为什么轮询而不是 WebSocket：后端本来就是同步的 SimpleHTTPServer，
+ * 一个 2 秒的 GET 比引一套推送简单得多；页面隐藏时不问。
+ *
+ * 变了之后做什么：
+ *   1. `WA2.assetsVer + 1`（立绘 / 背景 URL 会带 ?v=，绕过 WebView2 的图片缓存）
+ *   2. 重拉立绘索引（`WA2.sprite.loadIndex`）并按当前衣服+情绪重画
+ *   3. 重画当前背景（`__reapplyBg`，game.js 提供）
+ *   4. 提示一次「素材已更新」
+ *
+ * 后端关了热重载（`WA2_HOTRELOAD=0` 或 POST /api/hotreload {"on":false}）时这里什么都不做。
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+
+  var POLL_MS = 4000;
+  var timer = null;
+  var lastGen = -1;
+  var version = 0;
+
+  function toast(msg) {
+    try { (window.__toast || function () {}) (msg, 2200); } catch (e) {}
+  }
+
+  function apply(kinds) {
+    version += 1;
+    WA2.assetsVer = version;
+    var didSprite = false;
+    try {
+      if (WA2.sprite && WA2.sprite.loadIndex) {
+        WA2.sprite.loadIndex(function () {
+          try { if (WA2.sprite.refreshCurrent) WA2.sprite.refreshCurrent(); } catch (e) {}
+        });
+        didSprite = true;
+      }
+    } catch (e) {}
+    try { if (window.__reapplyBg) window.__reapplyBg(); } catch (e) {}
+    var what = (kinds || []).indexOf("character") >= 0 ? "角色素材" : "素材";
+    toast(what + "已更新" + (didSprite ? "" : "（下次切换时生效）"));
+    try { if (window.__dbg) window.__dbg("ASSET", "hot reload v" + version + " " + (kinds || []).join("/")); } catch (e) {}
+    return version;
+  }
+
+  function poll() {
+    if (typeof document !== "undefined" && document.hidden) return;
+    fetch("/api/hotreload", { cache: "no-store" })
+      .then(function (r) { return r.json(); })
+      .then(function (d) {
+        if (!d || !d.ok) return;
+        if (!d.enabled) return;
+        if (lastGen < 0) { lastGen = d.gen || 0; return; }   /* 第一次只记基线 */
+        if ((d.gen || 0) !== lastGen) {
+          lastGen = d.gen || 0;
+          apply(d.last_kinds || []);
+        }
+      })
+      .catch(function () { /* 后端没起来 / 不关心，下次再问 */ });
+  }
+
+  function start() {
+    if (timer) return;
+    timer = setInterval(poll, POLL_MS);
+    poll();
+  }
+
+  function stop() {
+    if (!timer) return;
+    clearInterval(timer);
+    timer = null;
+  }
+
+  function setEnabled(on) {
+    fetch("/api/hotreload", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ on: !!on })
+    }).then(function (r) { return r.json(); })
+      .then(function (d) {
+        toast(d && d.enabled ? "素材热重载已打开" : "素材热重载已关闭");
+        if (d && d.enabled) { lastGen = d.gen || 0; }
+      })
+      .catch(function () {});
+  }
+
+  WA2.hotReload = {
+    start: start,
+    stop: stop,
+    poll: poll,
+    apply: apply,
+    setEnabled: setEnabled,
+    version: function () { return version; },
+    polling: function () { return !!timer; }
+  };
+
+  start();
+})();
diff --git a/program/src/ui/wt-perf.js b/program/src/ui/wt-perf.js
new file mode 100644
index 0000000..5890d51
--- /dev/null
+++ b/program/src/ui/wt-perf.js
@@ -0,0 +1,101 @@
+/* perf.js —— 演出状态机：把「重播 / 流式输出 / 语音 / 浮层 / 切角色」收成一个仲裁点。
+ *
+ * 为什么要它：这些演出以前各管各的（回想拿到就播、新消息不打断重播、切角色时语音还在响），
+ * 状态一乱就出现「两个人同时说话」「切完了还在播上一句」这类问题。
+ *
+ * 状态（同时只有一个主状态，语音是叠加在上面的）：
+ *   IDLE / DIALOGUE_STREAMING / VOICE_PLAYING / REPLAYING / OVERLAY_OPEN / CHARACTER_SWITCHING
+ *
+ * 仲裁规则：
+ *   - 新消息（DIALOGUE_STREAMING）打断重播（调用方先 interrupt("REPLAYING") 再停语音）
+ *   - 切角色 / 流式输出时不许重播
+ *   - 浮层不算「忙」：回想本身就在浮层里，重播照常
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+
+  var S = {
+    IDLE: "IDLE",
+    DIALOGUE_STREAMING: "DIALOGUE_STREAMING",
+    VOICE_PLAYING: "VOICE_PLAYING",
+    REPLAYING: "REPLAYING",
+    OVERLAY_OPEN: "OVERLAY_OPEN",
+    CHARACTER_SWITCHING: "CHARACTER_SWITCHING"
+  };
+
+  /* 主状态优先级（越靠前越"忙"） */
+  var ORDER = [S.CHARACTER_SWITCHING, S.DIALOGUE_STREAMING, S.REPLAYING,
+               S.OVERLAY_OPEN, S.VOICE_PLAYING];
+
+  var counts = {};       /* 每种状态的占用计数：允许嵌套调用 */
+  var cur = S.IDLE;
+  var subs = [];
+
+  function recompute() {
+    var next = S.IDLE;
+    for (var i = 0; i < ORDER.length; i++) {
+      if (counts[ORDER[i]]) { next = ORDER[i]; break; }
+    }
+    if (next !== cur) {
+      var prev = cur;
+      cur = next;
+      for (var j = 0; j < subs.length; j++) {
+        try { subs[j](cur, prev); } catch (e) {}
+      }
+    }
+    return cur;
+  }
+
+  function begin(kind) {
+    if (!kind) return cur;
+    counts[kind] = (counts[kind] || 0) + 1;
+    return recompute();
+  }
+
+  function end(kind) {
+    if (!kind) return cur;
+    if (counts[kind]) counts[kind]--;
+    if (!counts[kind]) delete counts[kind];
+    return recompute();
+  }
+
+  /* 强行清掉某状态（比如新消息来了，把重播整个掐掉） */
+  function interrupt(kind) {
+    delete counts[kind];
+    return recompute();
+  }
+
+  function active(kind) { return !!counts[kind]; }
+
+  function is(kind) { return cur === kind; }
+
+  /* 现在能不能开始某种演出 */
+  function can(kind) {
+    if (kind === S.REPLAYING) {
+      return !counts[S.CHARACTER_SWITCHING] && !counts[S.DIALOGUE_STREAMING];
+    }
+    if (kind === S.DIALOGUE_STREAMING) {
+      return !counts[S.CHARACTER_SWITCHING];
+    }
+    return true;
+  }
+
+  function onChange(fn) { if (typeof fn === "function") subs.push(fn); }
+
+  var api = {
+    STATES: S,
+    begin: begin,
+    end: end,
+    interrupt: interrupt,
+    active: active,
+    is: is,
+    can: can,
+    current: function () { return cur; },
+    onChange: onChange,
+    counts: function () { return counts; }
+  };
+
+  WA2.perf = api;
+  if (WA2.register) WA2.register("perf", api);
+  window.__perf = api;
+})();
diff --git a/program/src/ui/wt-perfcfg.js b/program/src/ui/wt-perfcfg.js
new file mode 100644
index 0000000..e5c112a
--- /dev/null
+++ b/program/src/ui/wt-perfcfg.js
@@ -0,0 +1,62 @@
+/* 演出 / 切片规则（#19）：拉 /api/performance，给 wt-fade / wt-sprite 用。
+ *
+ * 这里**只存「每角色的覆盖值」**，不复制一份默认表：
+ *   · 没配 → 各模块用自己内置的默认（和平常完全一样）
+ *   · 配了 → 覆盖（淡化时长、情绪→表情、场景→衣服）
+ *
+ * 对外（WA2.perfCfg）：
+ *   refresh(cb)   重新拉一次（启动、切角色、改完文件）
+ *   get()         整包 {performance, slices, warnings}
+ *   fadeMs()      淡化时长（没配返回 0，让 wt-fade 用自己的默认）
+ *   moodMap()     情绪 → 表情 覆盖表（可能是空对象）
+ *   outfitMap()   场景 → 衣服 覆盖表（可能是空对象）
+ */
+(function () {
+  var WA2 = window.WA2 = window.WA2 || {};
+
+  var PKG = { performance: {}, slices: {}, warnings: [] };
+  var toasted = false;
+
+  function refresh(cb) {
+    fetch("/api/performance", { cache: "no-store" })
+      .then(function (r) { return r.json(); })
+      .then(function (d) {
+        if (!d || !d.ok) return;
+        PKG.performance = d.performance || {};
+        PKG.slices = d.slices || {};
+        PKG.warnings = d.warnings || [];
+        if (PKG.warnings.length && !toasted) {
+          toasted = true;
+          try {
+            (window.__toast || function () {})("演出配置有误，已用默认值：" + PKG.warnings[0], 4000);
+          } catch (e) {}
+        }
+        try { if (window.__dbg) window.__dbg("CFG", "performance loaded warn=" + PKG.warnings.length); } catch (e) {}
+        if (typeof cb === "function") { try { cb(PKG); } catch (e) {} }
+      })
+      .catch(function () { /* 拿不到就用内置默认，不打扰用户 */ });
+  }
+
+  function fadeMs() {
+    var v = (PKG.performance || {}).fade_ms;
+    return (typeof v === "number" && isFinite(v) && v > 0) ? v : 0;
+  }
+
+  function moodMap() {
+    return (PKG.performance && PKG.performance.mood_to_emotion) || {};
+  }
+
+  function outfitMap() {
+    return (PKG.performance && PKG.performance.outfit_by_scene) || {};
+  }
+
+  WA2.perfCfg = {
+    refresh: refresh,
+    get: function () { return PKG; },
+    fadeMs: fadeMs,
+    moodMap: moodMap,
+    outfitMap: outfitMap
+  };
+
+  refresh();
+})();
