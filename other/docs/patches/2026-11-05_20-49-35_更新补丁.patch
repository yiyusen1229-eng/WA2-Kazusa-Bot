@@ -0,0 +1,128 @@
+# -*- coding: utf-8 -*-
+"""降级类自测（#11：核心 / 边界 / 降级三类里的「降级」，不联网、不开界面）。
+
+跑法：
+    cd program
+    build_env/venv/Scripts/python.exe tools/test_degrade.py
+
+验的是「需求没满足时不崩、还能继续玩」：
+  1. 语音未命中：一条参考音频都没有 → 不合成、返回 None（前端只显示文字）
+  2. 响度算不出来：坏 wav / 未知格式 → 原样放行，不抛
+  3. 场景匹配失败：没有素材目录 / 目录里没这张 → 返回 {}，prompt_hint 仍给得出话
+  4. 原作检索不可用：没索引 / 角色关掉了检索 → 返回空串，不抛
+  5. 关系判定超时 / 返回怪东西：保留原阶段，不崩，下一轮还能再判
+"""
+import os
+import sys
+import tempfile
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+sys.path.insert(0, os.path.join(PROGRAM, "src"))
+
+_TMP = tempfile.mkdtemp(prefix="wa2_degrade_test_")
+os.environ["WA2_CACHE_DIR"] = _TMP
+os.environ["WA2_SESS_DIR"] = os.path.join(_TMP, "sessions")
+
+import audio_gain    # noqa: E402
+import persona_stage  # noqa: E402
+import scene_cg     # noqa: E402
+import story_rag    # noqa: E402
+import tts_client   # noqa: E402
+
+FAILS = []
+
+
+def check(name, cond, extra=""):
+    print(("  ok   " if cond else "  FAIL ") + name +
+          (("  " + str(extra)[:200]) if extra and not cond else ""))
+    if not cond:
+        FAILS.append(name)
+
+
+def main():
+    # ------------------------------------------------ 1 语音未命中（没有参考音频）
+    tts_client._IMPORTED = {"global": [], "by_emo": {}}
+    tts_client._ref_cache = {}
+    tts_client.load_refs = lambda: {}
+    tts_client._refs_sig = tts_client._char_voice_sig()
+    ref = tts_client.pick_ref("neutral")
+    check("没有参考音频：pick_ref 返回 (None, '')", ref == (None, ""), ref)
+    check("没有参考音频：任意情绪也不炸", tts_client.pick_ref("不存在的情绪") == (None, ""))
+    check("未就绪时 synthesize 返回 None（不抛）", tts_client.synthesize("测试一句") is None)
+    st = tts_client.status()
+    check("status 结构没变坏", isinstance(st, dict) and "ready" in st and "available" in st, st)
+
+    # ------------------------------------------------ 2 响度算不出来 → 原样放行
+    junk = b"NOT A WAV" * 100
+    info = audio_gain.probe(junk)
+    check("坏 wav：probe 标 not-wav、增益 0", info["format"] == "not-wav" and info["gain_db"] == 0.0, info)
+    out, info2 = audio_gain.apply(junk)
+    check("坏 wav：apply 原样返回", out == junk and info2["applied"] is False)
+    check("空字节也不炸", audio_gain.apply(b"")[0] == b"")
+
+    # ------------------------------------------------ 3 场景匹配失败
+    empty = tempfile.mkdtemp(prefix="wa2_no_assets_")
+    scene_cg.set_assets_dir(empty)
+    check("没有素材目录：match 返回 {}", scene_cg.match("教室（白天）", "") == {})
+    hint = scene_cg.prompt_hint()
+    check("没有素材目录：prompt_hint 仍返回字符串", isinstance(hint, str) and len(hint) > 0, hint[:40])
+    check("prompt_hint 不会堆出空括号", "【场景】" in hint, hint[:40])
+
+    # ------------------------------------------------ 4 原作检索不可用
+    story_rag._CACHE = {}
+    story_rag.GLOBAL_INDEX = os.path.join(_TMP, "没有这个索引.json.gz")
+    # v3 也一起藏起来：否则 active_index 会回落到真实存在的 story_index_v3.json.gz
+    story_rag.GLOBAL_INDEX_V3 = os.path.join(_TMP, "没有这个索引v3.json.gz")
+    check("没有索引：memory_context 返回空串",
+          story_rag.memory_context("今天天气不错") == "")
+    check("没有索引：last_hits 是合法空值",
+          isinstance(story_rag.last_hits().get("hits"), list), story_rag.last_hits())
+    check("没有索引：cached_blocks 返回 0", story_rag.cached_blocks() == 0, story_rag.cached_blocks())
+
+    # ------------------------------------------------ 5 关系判定超时 / 怪输出
+    persona_stage.reset()
+    msgs = []
+    for i in range(6):
+        msgs.append({"role": "user", "content": "在吗"})
+        msgs.append({"role": "assistant", "content": "「在的」"})
+
+    def boom(system, user):
+        raise TimeoutError("模拟云端超时")
+
+    persona_stage.set_llm(boom)
+    before = persona_stage.debug_state()
+    got = persona_stage.classify_now(msgs)
+    after = persona_stage.debug_state()
+    check("判定超时：保留原阶段、不抛", got == before["stage"], (got, before))
+    check("判定超时：轮数仍然记上了", after["rounds"] >= before["rounds"], (before, after))
+
+    persona_stage.set_llm(lambda s, u: "我不知道")     # 没有数字
+    check("返回怪东西：解析不到数字就保留原阶段",
+          persona_stage.classify_now(msgs) == after["stage"])
+
+    persona_stage.set_llm(lambda s, u: "3")            # 正常：只升不降
+    check("正常返回数字：阶段升到 3", persona_stage.classify_now(msgs) == 3)
+    persona_stage.set_llm(lambda s, u: "1")            # 想降回去：不许
+    check("只升不降：返回 1 也不降", persona_stage.classify_now(msgs) == 3)
+
+    persona_stage.set_llm(None)
+    persona_stage.reset()
+    marriage = [{"role": "user", "content": "我们结婚吧"},
+                {"role": "assistant", "content": "「……嗯」"}]
+    check("明确提到结婚：本地关键词直接封顶 4",
+          persona_stage.current(marriage) == 4, persona_stage.current(marriage))
+    check("封顶后 debug_state 也报 4", persona_stage.debug_state()["stage"] == 4)
+
+    print()
+    if FAILS:
+        print("失败 %d 项：%s" % (len(FAILS), " / ".join(FAILS)))
+        return 1
+    print("全部通过")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/program/tools/test_diag.py b/program/tools/test_diag.py
new file mode 100644
index 0000000..8514b15
--- /dev/null
+++ b/program/tools/test_diag.py
@@ -0,0 +1,171 @@
+# -*- coding: utf-8 -*-
+"""调试面板状态账本（diag.py）的自测（不联网、不开界面）。
+
+跑法：
+    cd program
+    build_env/venv/Scripts/python.exe tools/test_diag.py
+
+验的是：
+  1. token 估算：中日文 1 字≈1 token、英文 4 字≈1 token、空串 0
+  2. 计数器累加、取出来是快照（改返回值不影响内部）
+  3. note 覆盖写（只留最近一次）+ at 时间戳
+  4. round_record 滚动只留 KEEP 条，且自动 +1 计数
+  5. snapshot() 结构完整：server / counters / rounds / modules 六个块都在
+  6. snapshot() 是只读的：连跑两次，计数和轮次都不变
+  7. 面板数据里没有密钥、没有对话正文（只允许数字和小标签）
+  8. persona_stage.debug_state() 不推进状态（跑完 stage/rounds 不变）
+  9. story_rag.last_hits() 结构（没检索过也是合法空值）
+ 10. cache_io.stats() 的字段在 snapshot 里能对上
+"""
+import json
+import os
+import sys
+import tempfile
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+sys.path.insert(0, os.path.join(PROGRAM, "src"))
+
+# 先指到临时缓存目录，别碰真实运行状态
+_TMP = tempfile.mkdtemp(prefix="wa2_diag_test_")
+os.environ["WA2_CACHE_DIR"] = _TMP
+os.environ["WA2_SESS_DIR"] = os.path.join(_TMP, "sessions")
+
+import diag            # noqa: E402
+import cache_io        # noqa: E402
+import persona_stage   # noqa: E402
+import story_rag       # noqa: E402
+
+FAILS = []
+
+
+def check(name, cond, extra=""):
+    print(("  ok   " if cond else "  FAIL ") + name +
+          (("  " + str(extra)[:200]) if extra and not cond else ""))
+    if not cond:
+        FAILS.append(name)
+
+
+def main():
+    diag.reset()
+
+    # 1 --------------------------------------------------------------------
+    check("空串 0 token", diag.token_est("") == 0)
+    zh = diag.token_est("今天天气不错，我们去散步吧")
+    check("12 个汉字 ≈ 12~14 token", 12 <= zh <= 16, zh)
+    en = diag.token_est("abcdefghijkl")
+    check("12 个字母 ≈ 4 token", 3 <= en <= 6, en)
+    check("混排比纯英文贵", diag.token_est("你好 world") > diag.token_est("world"))
+
+    # 2 --------------------------------------------------------------------
+    diag.count("text.disk")
+    diag.count("text.disk")
+    diag.count("tts.hit", 3)
+    c = diag.counters()
+    check("计数器累加", c["text.disk"] == 2 and c["tts.hit"] == 3, c)
+    c["text.disk"] = 999
+    check("取出来的是快照（改返回值不影响内部）", diag.counters()["text.disk"] == 2)
+
+    # 3 --------------------------------------------------------------------
+    diag.note("scene", id="cafe_dusk", score=0.86)
+    diag.note("scene", id="school_day", score=0.9)
+    n = diag.note_get("scene")
+    check("note 覆盖写只留最近一次", n.get("id") == "school_day" and n.get("score") == 0.9, n)
+    check("note 带时间戳", isinstance(n.get("at"), int) and n["at"] > 0, n)
+
+    # 4 --------------------------------------------------------------------
+    for i in range(diag.KEEP + 5):
+        diag.round_record(ms=100 + i, model="m%d" % i, seg={"persona": i}, tokens={"system": i})
+    rs = diag.rounds()
+    check("轮次滚动只留 KEEP 条", len(rs) == diag.KEEP, len(rs))
+    check("留下的是最近的几条", rs[-1]["model"] == "m%d" % (diag.KEEP + 4), rs[-1])
+    check("round_record 自动 +1 计数", diag.counters()["chat.round"] == diag.KEEP + 5,
+          diag.counters().get("chat.round"))
+
+    # 5 --------------------------------------------------------------------
+    snap = diag.snapshot()
+    check("snapshot ok", snap.get("ok") is True)
+    check("server 块有 pid / 运行时长", isinstance(snap["server"].get("pid"), int)
+          and isinstance(snap["server"].get("uptime_s"), int), snap["server"])
+    check("rounds 长度对得上", len(snap["rounds"]) == diag.KEEP, len(snap["rounds"]))
+    mods = snap.get("modules") or {}
+    for k in ("memory", "stage", "tts", "story", "scene", "cache"):
+        check("modules.%s 在" % k, k in mods, list(mods))
+    check("cache 块有 checked / dropped",
+          "checked" in mods["cache"] and "dropped" in mods["cache"], mods["cache"])
+    check("memory 块有条目数和预算",
+          "entries" in mods["memory"] and "budget" in mods["memory"], mods["memory"])
+    check("stage 块有阶段和间隔",
+          "stage" in mods["stage"] and "every" in mods["stage"], mods["stage"])
+
+    # 6 --------------------------------------------------------------------
+    before = (len(diag.rounds()), dict(diag.counters()))
+    sn1 = diag.snapshot()
+    sn2 = diag.snapshot()
+    after = (len(diag.rounds()), dict(diag.counters()))
+    check("snapshot 只读（轮次 / 计数不变）", before == after, (before, after))
+    check("两次 snapshot 结构一致", set(sn1) == set(sn2), (list(sn1), list(sn2)))
+
+    # 7 --------------------------------------------------------------------
+    blob = json.dumps(snap, ensure_ascii=False)
+    check("面板数据里没有密钥样式的串", "sk-" not in blob and "api_key" not in blob)
+    # 允许的字段：数字 / 模型名 / 时期 / 衣服名 / 世界书条目标题 / 场景 id
+    secret_text = "这是不该出现在面板里的对话正文"
+    diag.round_record(model="deepseek-chat", seg={"persona": 800}, reply_chars=24)
+    blob2 = json.dumps(diag.snapshot(), ensure_ascii=False)
+    check("没有把正文写进账本", secret_text not in blob2)
+
+    # 账本里的字符串只允许是标签（模型名 / 时期 / 衣服 / 场景 id / 条目标题），不许是长文本
+    vals = []
+
+    def walk(v):
+        if isinstance(v, dict):
+            for x in v.values():
+                walk(x)
+        elif isinstance(v, list):
+            for x in v:
+                walk(x)
+        elif isinstance(v, str):
+            vals.append(v)
+
+    walk(diag.snapshot())
+    longest = max((len(v) for v in vals), default=0)
+    check("最长字段只有 %d 字（≤40，都是标签）" % longest, longest <= 40,
+          sorted(vals, key=len)[-3:] if vals else [])
+
+    # 8 --------------------------------------------------------------------
+    st1 = persona_stage.debug_state()
+    st2 = persona_stage.debug_state()
+    check("debug_state 字段齐",
+          all(k in st1 for k in ("stage", "rounds", "last_round", "seen", "every", "due_in", "busy")), st1)
+    check("debug_state 不推进状态", st1 == st2, (st1, st2))
+    check("阶段在 1~4", 1 <= st1["stage"] <= 4, st1)
+
+    # 9 --------------------------------------------------------------------
+    hits = story_rag.last_hits()
+    check("last_hits 是 dict 且有 hits 列表", isinstance(hits, dict) and isinstance(hits.get("hits"), list), hits)
+    check("cached_blocks 不触发加载（返回 0 或块数）",
+          isinstance(story_rag.cached_blocks(), int), story_rag.cached_blocks())
+
+    # 10 -------------------------------------------------------------------
+    cache_io.reset_stats()
+    snap3 = diag.snapshot()
+    check("cache 计数跟着 cache_io 走", snap3["modules"]["cache"]["checked"] == 0,
+          snap3["modules"]["cache"])
+
+    # 11 -------------------------------------------------------------------
+    diag.reset()
+    check("reset 清干净", diag.counters() == {} and diag.rounds() == [] and diag.note_get("scene") == {})
+
+    print()
+    if FAILS:
+        print("失败 %d 项：%s" % (len(FAILS), " / ".join(FAILS)))
+        return 1
+    print("全部通过")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
