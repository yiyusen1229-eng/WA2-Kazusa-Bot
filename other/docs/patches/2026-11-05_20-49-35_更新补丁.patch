index 0000000..b9ee4e7
--- /dev/null
+++ b/program/tools/test_fade.js
@@ -0,0 +1,168 @@
+/* wt-fade.js 的自测（纯 Node，不开界面、不需要浏览器）。
+ *
+ * 跑法：
+ *   cd program
+ *   node tools/test_fade.js
+ *
+ * 验的是：
+ *   1. 默认开、默认 240ms
+ *   2. prefs.xfade === false → 关；没这个键 → 开
+ *   3. xfadeMs 夹在 200~300（乱填回默认）
+ *   4. set() 写进 prefs，值同样被夹住
+ *   5. 没有 DOM 时 crossBg / crossSprite 不抛异常，fail 回调照常
+ *   6. 有 DOM 时：两层交替当「前层」，过渡结束后图回到 #bgLayer
+ *   7. describe() 的字段齐全
+ */
+const fs = require("fs");
+const path = require("path");
+const vm = require("vm");
+
+const code = fs.readFileSync(path.join(__dirname, "..", "src", "ui", "wt-fade.js"), "utf8");
+
+/* 假的 prefs：测试里随时换 */
+const prefs = { xfade: true, xfadeMs: 240 };
+const saved = [];
+const sandbox = {
+  window: {
+    WA2: { register: function () {} },
+    App: {
+      getPrefs: function () { return prefs; },
+      setPref: function (k, v) { saved.push([k, v]); prefs[k] = v; }
+    }
+  },
+  console: console,
+  setTimeout: setTimeout,
+  isFinite: isFinite,
+  Number: Number,
+  Math: Math
+};
+vm.createContext(sandbox);
+vm.runInContext(code, sandbox);
+
+const fade = sandbox.window.WA2.fade;
+
+const fails = [];
+function check(name, cond, extra) {
+  if (cond) {
+    console.log("  ok   " + name);
+  } else {
+    console.log("  FAIL " + name + (extra !== undefined ? "  " + JSON.stringify(extra) : ""));
+    fails.push(name);
+  }
+}
+
+/* ---------- 1~4：配置 ---------- */
+check("默认开", fade.enabled() === true);
+check("默认 240ms", fade.ms() === 240, fade.ms());
+
+prefs.xfade = false;
+check("xfade=false 就是关", fade.enabled() === false);
+delete prefs.xfade;
+check("没这个键算开（老设置文件）", fade.enabled() === true);
+
+prefs.xfadeMs = 50;
+check("太小夹到 200", fade.ms() === 200, fade.ms());
+prefs.xfadeMs = 999;
+check("太大夹到 300", fade.ms() === 300, fade.ms());
+prefs.xfadeMs = 250;
+check("范围内原样", fade.ms() === 250, fade.ms());
+prefs.xfadeMs = "abc";
+check("乱填回默认", fade.ms() === 240, fade.ms());
+prefs.xfadeMs = 0;
+check("0 回默认（不是夹到 200）", fade.ms() === 240, fade.ms());
+
+/* ---------- 4b：#19 角色演出配置 performance.json 的 fade_ms ---------- */
+delete prefs.xfadeMs;
+sandbox.window.WA2.perfCfg = { fadeMs: function () { return 280; } };
+check("没设 xfadeMs → 用角色配置 280", fade.ms() === 280, fade.ms());
+prefs.xfadeMs = 250;
+check("prefs 设了 → 压过角色配置", fade.ms() === 250, fade.ms());
+delete prefs.xfadeMs;
+sandbox.window.WA2.perfCfg = { fadeMs: function () { return 999; } };
+check("角色配置超上限 → 夹到 300", fade.ms() === 300, fade.ms());
+sandbox.window.WA2.perfCfg = { fadeMs: function () { return 10; } };
+check("角色配置太小 → 夹到 200", fade.ms() === 200, fade.ms());
+sandbox.window.WA2.perfCfg = { fadeMs: function () { return "abc"; } };
+check("角色配置乱填 → 内置默认 240", fade.ms() === 240, fade.ms());
+sandbox.window.WA2.perfCfg = { fadeMs: function () { throw new Error("boom"); } };
+check("角色配置抛错 → 内置默认 240", fade.ms() === 240, fade.ms());
+delete sandbox.window.WA2.perfCfg;
+check("没有 perfCfg → 内置默认 240", fade.ms() === 240, fade.ms());
+
+fade.set(false);
+check("set(false) 写进 prefs", prefs.xfade === false && saved.length === 1, saved);
+fade.set(true, 500);
+check("set(true,500) 把 ms 夹到 300", prefs.xfade === true && prefs.xfadeMs === 300, prefs);
+fade.set(true, 220);
+check("set(true,220) 保留 220", prefs.xfadeMs === 220, prefs);
+
+/* ---------- 5：没有 DOM ---------- */
+let failed = 0;
+const okNoDom = fade.crossBg("a.png", null, function () { failed++; });
+check("没有 DOM 时 crossBg 返回 false", okNoDom === false);
+check("没有 DOM 时 fail 被调用一次", failed === 1, failed);
+failed = 0;
+fade.crossSprite("a.png", null, function () { failed++; });
+check("没有 DOM 时 crossSprite 也走 fail", failed === 1, failed);
+
+/* ---------- 6：有 DOM（两层交替） ---------- */
+function fakeEl(id) {
+  return {
+    id: id,
+    style: {},
+    offsetWidth: 1,
+    classList: { _s: {}, add: function (c) { this._s[c] = 1; }, remove: function (c) { delete this._s[c]; }, contains: function (c) { return !!this._s[c]; } }
+  };
+}
+const els = { bgLayer: fakeEl("bgLayer"), bgLayer2: fakeEl("bgLayer2") };
+sandbox.document = { getElementById: function (id) { return els[id] || null; } };
+
+fade.crossBg("/game/assets/a.png");
+check("第一次过渡：新图落在 #bgLayer2（后加的层在上面）",
+  els.bgLayer2.style.backgroundImage === 'url("/game/assets/a.png")', els.bgLayer2.style);
+check("第一次过渡：#bgLayer 被压到 0", els.bgLayer.style.opacity === "0", els.bgLayer.style);
+
+fade.settle("/game/assets/a.png");
+check("收尾后图回到 #bgLayer",
+  els.bgLayer.style.backgroundImage === 'url("/game/assets/a.png")' && els.bgLayer.style.opacity === "1",
+  els.bgLayer.style);
+check("收尾后 #bgLayer2 归零并清图",
+  els.bgLayer2.style.opacity === "0" && els.bgLayer2.style.backgroundImage === "none",
+  els.bgLayer2.style);
+
+fade.crossBg("/game/assets/b.png");
+check("收尾之后的新过渡：#bgLayer2 重新当「淡入层」",
+  els.bgLayer2.style.backgroundImage === 'url("/game/assets/b.png")' &&
+  els.bgLayer2.style.opacity === "1" &&
+  els.bgLayer.style.opacity === "0",
+  [els.bgLayer.style, els.bgLayer2.style]);
+
+/* 连着换两张、中间不 settle：第二次要落在另一层（不然新图先盖旧图再淡自己，会闪） */
+fade.settle("/game/assets/b.png");
+fade.crossBg("/game/assets/c.png");
+fade.crossBg("/game/assets/d.png");
+check("连着换时第二张落在 #bgLayer 上（前层交替）",
+  els.bgLayer.style.backgroundImage === 'url("/game/assets/d.png")' &&
+  els.bgLayer.style.opacity === "1" &&
+  els.bgLayer2.style.backgroundImage === 'url("/game/assets/c.png")',
+  [els.bgLayer.style, els.bgLayer2.style]);
+
+/* 关掉过渡：立刻换，不留中间态 */
+prefs.xfade = false;
+fade.crossBg("/game/assets/c.png");
+check("关过渡时直接换到 #bgLayer",
+  els.bgLayer.style.backgroundImage === 'url("/game/assets/c.png")' &&
+  els.bgLayer.style.opacity === "1" && els.bgLayer.style.transition === "none",
+  els.bgLayer.style);
+
+/* ---------- 7：describe ---------- */
+const d = fade.describe();
+check("describe 有 enabled/ms", typeof d.enabled === "boolean" && typeof d.ms === "number", d);
+check("describe 的 enabled 跟着 prefs 走", d.enabled === false, d);
+
+console.log();
+if (fails.length) {
+  console.log("失败 " + fails.length + " 项：" + fails.join(" / "));
+  process.exit(1);
+}
+console.log("全部通过");
diff --git a/program/tools/test_hotreload.js b/program/tools/test_hotreload.js
new file mode 100644
index 0000000..fd2abc9
--- /dev/null
+++ b/program/tools/test_hotreload.js
@@ -0,0 +1,139 @@
+/* wt-hotreload.js 的自测（纯 Node，不开界面）。
+ *
+ * 跑法：
+ *   cd program
+ *   node tools/test_hotreload.js
+ *
+ * 验的是：
+ *   1. 第一次拿到 gen 只记基线，不刷新画面
+ *   2. gen 没变 → 什么都不做
+ *   3. gen 变了 → assetsVer+1、重拉立绘索引、重画当前立绘与背景、提示一次
+ *   4. 后端 enabled=false → 不动作
+ *   5. 页面隐藏时不发请求
+ *   6. stop/start 控制轮询；apply(["character"]) 的提示是「角色素材」
+ */
+const fs = require("fs");
+const path = require("path");
+const vm = require("vm");
+
+const code = fs.readFileSync(path.join(__dirname, "..", "src", "ui", "wt-hotreload.js"), "utf8");
+
+const fails = [];
+function check(name, cond, extra) {
+  if (cond) console.log("  ok   " + name);
+  else { console.log("  FAIL " + name + (extra !== undefined ? "  " + JSON.stringify(extra) : "")); fails.push(name); }
+}
+
+function make(responses) {
+  const toasts = [], dbg = [], calls = [];
+  let fetches = 0;
+  let queue = responses.slice();
+  const timers = { id: 1, fn: null, cleared: false };
+  const sb = {
+    window: {
+      WA2: {
+        sprite: {
+          loadIndex: function (cb) { calls.push("loadIndex"); if (cb) cb(); },
+          refreshCurrent: function () { calls.push("refreshCurrent"); return true; }
+        },
+        __reapplyBg: function () { calls.push("reapplyBg"); return true; },
+        __toast: function (t) { toasts.push(String(t)); },
+        __dbg: function (a, b) { dbg.push([a, b]); }
+      },
+      document: { hidden: false },
+      __toast: function (t) { toasts.push(String(t)); },
+      __dbg: function (a, b) { dbg.push([a, b]); }
+    },
+    document: { hidden: false },
+    console: console,
+    Promise: Promise,
+    JSON: JSON,
+    String: String,
+    setInterval: function (fn) { timers.fn = fn; return timers.id; },
+    clearInterval: function () { timers.cleared = true; timers.fn = null; },
+    fetch: function (url, opts) {
+      fetches += 1;
+      if (opts && opts.method === "POST") {
+        return Promise.resolve({ json: function () { return Promise.resolve({ ok: true, enabled: true, gen: 9 }); } });
+      }
+      const next = queue.length ? queue.shift() : { ok: true, enabled: true, gen: -1 };
+      return Promise.resolve({ json: function () { return Promise.resolve(next); } });
+    }
+  };
+  // 让 window.__reapplyBg 也能从 window 上取到
+  sb.window.__reapplyBg = sb.window.WA2.__reapplyBg;
+  vm.createContext(sb);
+  vm.runInContext(code, sb);
+  return { sb, calls, toasts, dbg, timers, fetches: function () { return fetches; }, queue: queue };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 10));
+
+(async function main() {
+  /* 第一次响应的 gen=1：只记基线 */
+  const A = make([{ ok: true, enabled: true, gen: 1 }]);
+  check("加载时自动轮询了一次", A.fetches() === 1, A.fetches());
+  await tick();
+  check("基线不触发刷新", A.calls.length === 0, A.calls);
+  check("assetsVer 还是 0", A.sb.window.WA2.assetsVer === undefined || A.sb.window.WA2.assetsVer === 0);
+
+  /* gen 没变 */
+  A.queue.push({ ok: true, enabled: true, gen: 1 });
+  A.sb.window.WA2.hotReload.poll();
+  await tick();
+  check("gen 没变不动手", A.calls.length === 0, A.calls);
+
+  /* gen 变了 */
+  A.queue.push({ ok: true, enabled: true, gen: 2, last_kinds: ["assets"] });
+  A.sb.window.WA2.hotReload.poll();
+  await tick();
+  check("gen 变了：重拉立绘索引", A.calls.indexOf("loadIndex") >= 0, A.calls);
+  check("gen 变了：重画当前立绘", A.calls.indexOf("refreshCurrent") >= 0, A.calls);
+  check("gen 变了：重画背景", A.calls.indexOf("reapplyBg") >= 0, A.calls);
+  check("assetsVer 变成 1", A.sb.window.WA2.assetsVer === 1, A.sb.window.WA2.assetsVer);
+  check("提示「素材已更新」", A.toasts.some(function (t) { return t.indexOf("素材已更新") >= 0; }), A.toasts);
+  check("时间线记了一条 ASSET", A.dbg.some(function (d) { return d[0] === "ASSET"; }), A.dbg);
+
+  /* 再变一次：版本继续涨（URL 带 ?v= 才能真的换图） */
+  A.queue.push({ ok: true, enabled: true, gen: 3, last_kinds: ["character"] });
+  A.sb.window.WA2.hotReload.poll();
+  await tick();
+  check("assetsVer 变成 2", A.sb.window.WA2.assetsVer === 2, A.sb.window.WA2.assetsVer);
+  check("角色素材的提示文案", A.toasts.some(function (t) { return t.indexOf("角色素材") >= 0; }), A.toasts);
+
+  /* 后端关了 */
+  const before = A.calls.length;
+  A.queue.push({ ok: true, enabled: false, gen: 4 });
+  A.sb.window.WA2.hotReload.poll();
+  await tick();
+  check("enabled=false 不动作", A.calls.length === before, A.calls.length - before);
+
+  /* 页面隐藏时不发请求 */
+  const B = make([{ ok: true, enabled: true, gen: 1 }]);
+  await tick();
+  B.sb.document.hidden = true;
+  B.sb.window.document.hidden = true;
+  const f0 = B.fetches();
+  B.sb.window.WA2.hotReload.poll();
+  await tick();
+  check("隐藏时不发请求", B.fetches() === f0, [f0, B.fetches()]);
+
+  /* stop / start */
+  B.sb.window.WA2.hotReload.stop();
+  check("stop() 之后不轮询", B.sb.window.WA2.hotReload.polling() === false);
+  check("stop() 清了定时器", B.timers.cleared === true);
+  B.sb.window.WA2.hotReload.start();
+  check("start() 重新开始轮询", B.sb.window.WA2.hotReload.polling() === true);
+
+  /* 开关接口 */
+  B.sb.window.WA2.hotReload.setEnabled(false);
+  await tick();
+  check("setEnabled 会发 POST（本地开关）", B.toasts.length > 0, B.toasts);
+
+  console.log();
+  if (fails.length) {
+    console.log("失败 " + fails.length + " 项：" + fails.join(" / "));
+    process.exit(1);
+  }
+  console.log("全部通过");
+})();
diff --git a/program/tools/test_hotreload.py b/program/tools/test_hotreload.py
new file mode 100644
index 0000000..81d62d7
--- /dev/null
+++ b/program/tools/test_hotreload.py
@@ -0,0 +1,162 @@
+# -*- coding: utf-8 -*-
+"""素材热重载（hotreload.py）的自测（#20，不联网、不开界面）。
+
+跑法：
+    cd program
+    build_env/venv/Scripts/python.exe tools/test_hotreload.py
+
+验的是：
+  1. 第一次 tick 只记基线，不算「变了」
+  2. 文件变了：第一个 tick 只挂起，等签名稳定一个 SETTLE 才真正触发（避免拷到一半）
+  3. 触发时：gen +1、kinds 正确、所有勾子都被调用
+  4. 关掉（enabled=False）时什么都不做
+  5. 某个勾子抛错：别的勾子照跑，错误记进 state()，不把巡检线程弄死
+  6. 角色目录变了 → kinds 里是 character（切角色后自动跟着走）
+  7. start/stop 线程生命周期；state() 字段齐全
+"""
+import json
+import os
+import sys
+import tempfile
+import time
+
+sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROGRAM = os.path.dirname(HERE)
+sys.path.insert(0, os.path.join(PROGRAM, "src"))
+
+_TMP = tempfile.mkdtemp(prefix="wa2_hotreload_test_")
+os.environ["WA2_USER_DIR"] = _TMP
+os.environ["WA2_CACHE_DIR"] = os.path.join(_TMP, "cache")
+os.environ["WA2_HOTRELOAD_S"] = "60"          # 线程不用真跑那么勤
+
+import characters  # noqa: E402
+import hotreload   # noqa: E402
+
+FAILS = []
+
+
+def check(name, cond, extra=""):
+    print(("  ok   " if cond else "  FAIL ") + name +
+          (("  " + str(extra)[:200]) if extra and not cond else ""))
+    if not cond:
+        FAILS.append(name)
+
+
+def main():
+    assets = os.path.join(_TMP, "assets")
+    os.makedirs(os.path.join(assets, "cg"), exist_ok=True)
+    cid = "和纱"
+    char = os.path.join(_TMP, "characters", cid)
+    os.makedirs(os.path.join(char, "portrait"), exist_ok=True)
+    with open(os.path.join(_TMP, "characters", "active.json"), "w", encoding="utf-8") as f:
+        json.dump({"id": cid}, f, ensure_ascii=False)
+
+    called = []
+    hotreload.reset()
+    hotreload.watch(assets, char)
+    hotreload.set_hooks({
+        "one": lambda kinds: called.append(("one", list(kinds))),
+        "two": lambda kinds: called.append(("two", list(kinds))),
+    })
+
+    # ---------------- 1 基线
+    t0 = 1000.0
+    check("第一次 tick 不算「变了」", hotreload.tick(now=t0) is False)
+    check("第一次 tick 不调勾子", called == [], called)
+
+    # ---------------- 2/3 变了 → 等稳定 → 触发
+    time.sleep(0.01)
+    with open(os.path.join(assets, "cg", "a.png"), "wb") as f:
+        f.write(b"x" * 100)
+    check("刚变：只挂起不触发", hotreload.tick(now=t0 + 1) is False)
+    check("刚变：还没调勾子", called == [], called)
+    check("稳定一个 SETTLE 之后触发", hotreload.tick(now=t0 + 1 + hotreload.SETTLE + 0.01) is True)
+    check("勾子被调了（两个都调）", [c[0] for c in called] == ["one", "two"], called)
+    check("kinds 里有 assets", called and called[0][1] == ["assets"], called)
+    st = hotreload.state()
+    check("gen 变成 1", st["gen"] == 1, st["gen"])
+    check("last_kinds 记录正确", st["last_kinds"] == ["assets"], st["last_kinds"])
+    check("没有错误", st["errors"] == [], st["errors"])
+    check("state 字段齐全",
+          set(st) >= {"ok", "enabled", "gen", "interval", "settle", "last_at",
+                      "last_kinds", "errors", "ms", "watching", "running"}, sorted(st))
+
+    # 再变一次：内容不同 → 再来一轮
+    time.sleep(0.01)
+    with open(os.path.join(assets, "cg", "a.png"), "wb") as f:
+        f.write(b"y" * 200)
+    hotreload.tick(now=t0 + 3)
+    check("第二次变化也会触发", hotreload.tick(now=t0 + 3 + hotreload.SETTLE + 0.01) is True)
+    check("gen 变成 2", hotreload.state()["gen"] == 2, hotreload.state()["gen"])
+
+    # 没变化时不重复触发
+    check("没变化 → 不触发", hotreload.tick(now=t0 + 10) is False)
+
+    # ---------------- 4 关掉
+    called.clear()
+    hotreload.set_enabled(False)
+    time.sleep(0.01)
+    with open(os.path.join(assets, "cg", "a.png"), "wb") as f:
+        f.write(b"z" * 300)
+    check("关掉之后 tick 直接返回 False", hotreload.tick(now=t0 + 20) is False)
+    check("关掉之后不调勾子", called == [], called)
+    hotreload.set_enabled(True)
+    hotreload.reset()
+    hotreload.watch(assets, char)
+    hotreload.tick(now=t0 + 21)                 # 重记基线
+
+    # ---------------- 5 勾子失败
+    boom = []
+
+    def bad(kinds):
+        boom.append(kinds)
+        raise RuntimeError("模拟加载失败")
+
+    called.clear()
+    hotreload.set_hooks({"bad": bad, "good": lambda kinds: called.append(("good", list(kinds)))})
+    time.sleep(0.01)
+    with open(os.path.join(assets, "cg", "b.png"), "wb") as f:
+        f.write(b"1" * 50)
+    hotreload.tick(now=t0 + 30)
+    check("失败的那次也算触发", hotreload.tick(now=t0 + 30 + hotreload.SETTLE + 0.01) is True)
+    check("坏勾子被调了", len(boom) == 1, boom)
+    check("好勾子照跑", [c[0] for c in called] == ["good"], called)
+    st = hotreload.state()
+    check("错误被记进 state", any("模拟加载失败" in x for x in st["errors"]), st["errors"])
+    check("巡检线程不受影响（还能继续 tick）", isinstance(hotreload.tick(now=t0 + 40), bool))
+
+    # ---------------- 6 角色目录
+    hotreload.reset()
+    hotreload.watch(assets, char)
+    hotreload.set_hooks({"one": lambda kinds: called.append(("one", list(kinds)))})
+    called.clear()
+    hotreload.tick(now=t0 + 50)
+    time.sleep(0.01)
+    with open(os.path.join(char, "portrait", "x.png"), "wb") as f:
+        f.write(b"p" * 10)
+    hotreload.tick(now=t0 + 51)
+    hotreload.tick(now=t0 + 51 + hotreload.SETTLE + 0.01)
+    check("角色目录变了 → kinds 是 character", called and called[-1][1] == ["character"], called)
+
+    # ---------------- 7 线程
+    hotreload.set_enabled(True)
+    check("start() 返回 True", hotreload.start() is True)
+    check("线程在跑", hotreload.state()["running"] is True)
+    check("重复 start 不会起第二个", hotreload.start() is False)
+    check("stop() 之后 running=False", hotreload.stop() is True and
+          hotreload.state()["running"] is False)
+    hotreload.set_enabled(False)
+    check("关掉之后 start() 不起线程", hotreload.start() is False)
+
+    print()
+    if FAILS:
+        print("失败 %d 项：%s" % (len(FAILS), " / ".join(FAILS)))
+        return 1
+    print("全部通过")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
