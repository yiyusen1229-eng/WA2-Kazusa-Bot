index 0000000..ca1b3b6
--- /dev/null
+++ b/program/src/diag.py
@@ -0,0 +1,214 @@
+# -*- coding: utf-8 -*-
+"""调试面板的只读状态账本（#13）。
+
+面板只需要回答四个问题：这一轮提示词花在哪、命中了什么、缓存有没有用上、
+分类器 / 关系阶段现在什么状态。所以这里只记**数字和标签**——不记对话正文、
+不记密钥（面板不是聊天记录查看器，也不该成为脱敏漏洞）。
+
+写法：写的一方（api_chat / api_text / tts_client / …）只管往里塞，
+读的一方 `/api/debug/state` 一次打包。HTTP 服务是多线程的，所以都加锁。
+
+对外：
+    count(name, n=1)              计数器（命中 / 渲染 / 轮次）
+    note(kind, **kw)              模块状态（覆盖写，只留最近一次）
+    note_get(kind)                读某个模块的状态
+    round_record(**kw)            一轮对话的指标（滚动保留 KEEP 条）
+    snapshot()                    面板用的整包（/api/debug/state 原样返回）
+    token_est(s)                  近似 token（规则同 memory.est_text）
+    reset()                       自测用：清空
+"""
+import collections
+import os
+import threading
+import time
+
+KEEP = 8                         # 面板只看最近 8 轮，再多也没人看
+
+_LOCK = threading.RLock()
+_COUNTERS = collections.Counter()
+_NOTES = {}
+_ROUNDS = collections.deque(maxlen=KEEP)
+_START = time.time()
+
+
+# ------------------------------------------------------------------ 写入
+
+def count(name, n=1):
+    """计数器 +n（名字用 `域.事件`：text.disk / tts.hit / chat.round …）"""
+    if not name:
+        return
+    with _LOCK:
+        _COUNTERS[name] += n
+
+
+def counters():
+    with _LOCK:
+        return dict(_COUNTERS)
+
+
+def note(kind, **kw):
+    """记某个模块的最近状态（覆盖写）"""
+    if not kind:
+        return
+    kw["at"] = int(time.time())
+    with _LOCK:
+        _NOTES[kind] = kw
+
+
+def note_get(kind):
+    with _LOCK:
+        return dict(_NOTES.get(kind) or {})
+
+
+def round_record(**kw):
+    """记一轮对话的指标；只保留最近 KEEP 条"""
+    kw["at"] = int(time.time())
+    with _LOCK:
+        _ROUNDS.append(kw)
+        _COUNTERS["chat.round"] += 1
+
+
+def rounds():
+    with _LOCK:
+        return [dict(r) for r in _ROUNDS]
+
+
+def reset():
+    with _LOCK:
+        _COUNTERS.clear()
+        _NOTES.clear()
+        _ROUNDS.clear()
+
+
+def token_est(s):
+    """近似 token。规则统一走 memory.est_text（中日文 1 字 ≈ 1 token）"""
+    if not s:
+        return 0
+    try:
+        import memory
+        return memory.est_text(s)
+    except Exception:
+        return int(len(s) * 0.6)
+
+
+def uptime_s():
+    return int(time.time() - _START)
+
+
+# ------------------------------------------------------------------ 各模块快照
+
+def _server():
+    out = {"pid": os.getpid(), "uptime_s": uptime_s()}
+    try:
+        import version
+        out["version"] = version.VERSION
+    except Exception:
+        out["version"] = ""
+    out["assets_env"] = bool(os.environ.get("WA2_ASSETS_DIR"))
+    out["sess_env"] = bool(os.environ.get("WA2_SESS_DIR"))
+    return out
+
+
+def _memory_block():
+    """对话记忆书：条目数 / 覆盖到第几轮 / 三档预算"""
+    try:
+        import memory
+        r = memory.runtime() or {}
+        trig, recent_b, entries_b = memory.budget(True)
+        entries = r.get("entries") or []
+        return {
+            "entries": len(entries),
+            "max_entries": int(memory.cfg().get("max_entries") or 0),
+            "covered": int(r.get("covered") or 0),
+            "turns": int(r.get("turns") or 0),
+            "packs": int(r.get("packs") or 0),
+            "window_start": int(r.get("window_start") or 0),
+            "budget": {"trigger": trig, "recent": recent_b, "entries": entries_b},
+            "slot": r.get("slot") or "",
+        }
+    except Exception as e:
+        return {"error": str(e)[:80]}
+
+
+def _stage_block():
+    """关系阶段分类器：档位 / 轮数 / 是否在后台跑 / 下次什么时候判"""
+    try:
+        import persona_stage
+        if hasattr(persona_stage, "debug_state"):
+            return persona_stage.debug_state()
+        st = persona_stage._load()
+        return dict(st)
+    except Exception as e:
+        return {"error": str(e)[:80]}
+
+
+def _tts_block():
+    try:
+        import tts_client, audio_gain
+        st = tts_client.status() or {}
+        return {
+            "available": bool(st.get("available")),
+            "ready": bool(st.get("ready")),
+            "error": (st.get("error") or "")[:60],
+            "last": note_get("tts"),
+            "gain_memo": (audio_gain.stats() or {}).get("memo"),
+        }
+    except Exception as e:
+        return {"error": str(e)[:80]}
+
+
+def _cache_block():
+    out = {}
+    try:
+        import cache_io
+        out.update(cache_io.stats())
+    except Exception as e:
+        out["error"] = str(e)[:80]
+    return out
+
+
+def _story_block():
+    """原作检索：最近一次命中（只要出处和分数，不返回正文）"""
+    out = {}
+    try:
+        import story_rag
+        out.update(story_rag.last_hits() or {})
+        out["enabled"] = bool(story_rag.enabled())
+        out["docs"] = story_rag.cached_blocks()     # 只报已加载的块数，不触发加载
+    except Exception as e:
+        out["error"] = str(e)[:80]
+    return out
+
+
+def _scene_block():
+    return dict(note_get("scene") or {})
+
+
+def _perf_block():
+    """最近一次性能采样（#14）：内存 / 线程 / 句柄 / GDI / 缓存体积"""
+    try:
+        import perf
+        return dict(perf.last() or {})
+    except Exception as e:
+        return {"error": str(e)[:80]}
+
+
+# ------------------------------------------------------------------ 面板整包
+
+def snapshot():
+    """`/api/debug/state` 的返回值。全部只读，不改任何运行时状态。"""
+    return {
+        "ok": True,
+        "server": _server(),
+        "counters": counters(),
+        "rounds": rounds(),
+        "modules": {
+            "memory": _memory_block(),
+            "stage": _stage_block(),
+            "tts": _tts_block(),
+            "story": _story_block(),
+            "scene": _scene_block(),
+            "perf": _perf_block(),
+            "cache": _cache_block(),
+        },
+    }
diff --git a/program/src/hotreload.py b/program/src/hotreload.py
new file mode 100644
index 0000000..8b6a115
--- /dev/null
+++ b/program/src/hotreload.py
@@ -0,0 +1,228 @@
+# -*- coding: utf-8 -*-
+"""素材热重载（#20）：盯着素材目录，变了就让缓存失效、前端重拉。
+
+不装 watchdog：每 2 秒 stat 一遍受监视的目录（几百个文件，毫秒级），够了。
+
+规矩：
+  · **只在签名稳定后动作**：正在拷贝一张大图时文件大小会变，等它稳定一个周期再触发，
+    免得加载到半张图（`SETTLE`）。
+  · **失败不影响别人**：每个回调单独 try/except，失败的记进 `last["errors"]` 并写 WARN，
+    别的勾子照跑；素材本身不动，前端继续用旧图。
+  · **可关**：`WA2_HOTRELOAD=0`，或运行时 `POST /api/hotreload {"on": false}`。
+  · 只留最近一次状态，不写文件。
+
+对外：
+    start() / stop() / enabled() / set_enabled()
+    watch(assets_dir, char_dir)   设置要盯的两个根
+    set_hooks(dict)               注入失效动作（main 里接）
+    tick()                        跑一次检查（返回是否触发了重载；自测直接调）
+    state()                       {enabled, gen, last_at, last_kinds, interval, errors}
+"""
+import os
+import threading
+import time
+
+import applog
+import characters
+
+INTERVAL = max(0.5, float(os.environ.get("WA2_HOTRELOAD_S") or 2.0))
+SETTLE = 0.8                     # 签名要保持这么久不变才动作
+MAX_ENTRIES = 6000               # 单次扫描上限（超大素材目录不至于卡）
+
+_LOCK = threading.Lock()
+_THREAD = None
+_STOP = threading.Event()
+_ENABLED = (os.environ.get("WA2_HOTRELOAD") or "1") != "0"
+
+_ROOTS = {"assets": "", "character": ""}
+_HOOKS = {}
+_SEEN = {}           # 上一次「稳定」的签名
+_PENDING = {}        # 观察到但还没稳定的签名
+_PENDING_AT = 0.0
+_GEN = 0
+_LAST = {"at": "", "kinds": [], "errors": [], "ms": 0}
+
+
+def set_hooks(hooks):
+    """{"name": callable(kind)}；main 里接：字模缓存 / 立绘索引 / 素材报告"""
+    _HOOKS.clear()
+    _HOOKS.update(hooks or {})
+
+
+def watch(assets_dir="", char_dir=""):
+    _ROOTS["assets"] = assets_dir or ""
+    _ROOTS["character"] = char_dir or ""
+
+
+def enabled():
+    return _ENABLED
+
+
+def set_enabled(on):
+    global _ENABLED, _PENDING_AT
+    _ENABLED = bool(on)
+    _PENDING.clear()
+    _PENDING_AT = 0.0
+    return _ENABLED
+
+
+def _sig_dir(root):
+    """(文件数, 最大 mtime_ns, 总字节)；扫不到返回 (0, 0, 0)"""
+    if not root or not os.path.isdir(root):
+        return (0, 0, 0)
+    n = 0
+    mx = 0
+    total = 0
+    stack = [root]
+    while stack and n < MAX_ENTRIES:
+        d = stack.pop()
+        try:
+            with os.scandir(d) as it:
+                for e in it:
+                    try:
+                        if e.is_dir(follow_symlinks=False):
+                            if len(stack) < 64:
+                                stack.append(e.path)
+                            continue
+                        st = e.stat(follow_symlinks=False)
+                        n += 1
+                        total += st.st_size
+                        if st.st_mtime_ns > mx:
+                            mx = st.st_mtime_ns
+                    except OSError:
+                        continue
+        except OSError:
+            continue
+    return (n, mx, total)
+
+
+def signature():
+    """{"assets": (...), "character": (...)}；角色目录每次现取，切角色自动跟着走"""
+    roots = {"assets": _ROOTS["assets"], "character": _ROOTS["character"]}
+    if not roots["character"]:
+        try:
+            roots["character"] = characters.active_dir()
+        except Exception:
+            roots["character"] = ""
+    return {k: _sig_dir(v) for k, v in roots.items()}
+
+
+def _changed_kinds(old, new):
+    return [k for k in new if old.get(k) != new.get(k)]
+
+
+def _fire(kinds):
+    global _GEN
+    t0 = time.time()
+    errors = []
+    for name, fn in list(_HOOKS.items()):
+        try:
+            fn(kinds)
+        except Exception as e:
+            errors.append("%s: %s" % (name, e))
+            try:
+                applog.log("热重载：%s 失败（继续用旧素材）：%s" % (name, e), "WARN")
+            except Exception:
+                pass
+    with _LOCK:
+        _GEN += 1
+        _LAST.update({"at": time.strftime("%H:%M:%S"), "kinds": list(kinds),
+                      "errors": errors, "ms": int((time.time() - t0) * 1000)})
+    if not errors:
+        try:
+            applog.log("热重载：%s 变了，缓存已失效（第 %d 代）"
+                       % ("/".join(kinds), _GEN), "ASSET")
+        except Exception:
+            pass
+    return not errors
+
+
+def tick(now=None):
+    """检查一次。返回是否触发了一次重载（自测直接调，不起线程）。"""
+    global _PENDING_AT
+    if not _ENABLED:
+        return False
+    now = time.time() if now is None else now
+    sig = signature()
+    if not _SEEN:
+        # 第一次只记基线，不触发（启动时不该算「变了」）
+        _SEEN.update(sig)
+        return False
+    kinds = _changed_kinds(_SEEN, sig)
+    if not kinds:
+        _PENDING.clear()
+        _PENDING_AT = 0.0
+        return False
+    if _PENDING and _changed_kinds(_PENDING, sig):
+        # 还在变（正在拷贝）→ 继续等它稳定
+        _PENDING.clear()
+        _PENDING.update(sig)
+        _PENDING_AT = now
+        return False
+    if not _PENDING:
+        _PENDING.update(sig)
+        _PENDING_AT = now
+        return False
+    if now - _PENDING_AT < SETTLE:
+        return False
+    # 稳定了一个 SETTLE 周期：动作
+    _SEEN.clear()
+    _SEEN.update(sig)
+    _PENDING.clear()
+    _PENDING_AT = 0.0
+    _fire(kinds)
+    return True
+
+
+def _loop():
+    while not _STOP.is_set():
+        try:
+            tick()
+        except Exception as e:
+            try:
+                applog.log("热重载巡检异常（不影响使用）：%s" % e, "WARN")
+            except Exception:
+                pass
+        _STOP.wait(INTERVAL)
+
+
+def start():
+    global _THREAD
+    if _THREAD and _THREAD.is_alive():
+        return False
+    if not _ENABLED:
+        return False
+    _STOP.clear()
+    _THREAD = threading.Thread(target=_loop, name="hotreload", daemon=True)
+    _THREAD.start()
+    return True
+
+
+def stop():
+    _STOP.set()
+    t = _THREAD
+    if t and t.is_alive():
+        t.join(timeout=INTERVAL + 1)
+    return True
+
+
+def state():
+    with _LOCK:
+        return {"ok": True, "enabled": _ENABLED, "gen": _GEN,
+                "interval": INTERVAL, "settle": SETTLE,
+                "last_at": _LAST["at"], "last_kinds": list(_LAST["kinds"]),
+                "errors": list(_LAST["errors"]), "ms": _LAST["ms"],
+                "watching": {k: bool(v) for k, v in _ROOTS.items()},
+                "running": bool(_THREAD and _THREAD.is_alive())}
+
+
+def reset():
+    """自测用"""
+    global _GEN, _PENDING_AT
+    with _LOCK:
+        _GEN = 0
+        _LAST.update({"at": "", "kinds": [], "errors": [], "ms": 0})
+    _SEEN.clear()
+    _PENDING.clear()
+    _PENDING_AT = 0.0
+    _HOOKS.clear()
diff --git a/program/src/logpack.py b/program/src/logpack.py
new file mode 100644
index 0000000..fe0f093
--- /dev/null
+++ b/program/src/logpack.py
@@ -0,0 +1,424 @@
+# -*- coding: utf-8 -*-
+"""日志保留 + 诊断包导出（#15）。
+
+两件事：
+  1. **按天滚动**：`logs/app-YYYYMMDD.log` 只留最近 N 天（`WA2_LOG_KEEP_DAYS`，默认 14）；
+     崩溃现场（`crash_*.log` / `crash_*_auto.json`）只留最新 10 份。
+     启动时跑一次，不占运行时间。
+  2. **诊断包**：把「日志 + 脱敏配置 + 素材报告 + 版本信息 + 调试状态」打成一个 zip，
+     交给开发者就能查问题，而**默认不含对话原文**。
+
+脱敏（导出前统一过一遍 `scrub()`，不是靠日志本身干净）：
+  · 密钥：交给 `secret.redact()`（`sk-...` / `Bearer ...` / `api_key: ...`）
+  · 带文字的查询串：`/api/text?text=...`、`/api/tts?text=...` → `<已隐藏>`
+    （日志里记的是请求路径，这两个接口的路径本身就带对话 / 朗读文本）
+  · 绝对路径：`C:\\Users\\<用户名>\\...` → `%USERPROFILE%`；其它盘符路径只留文件名
+  · `prefs.json` / `config.json` 只带「非敏感字段 + 掩码」
+
+对外：
+    KEEP_DAYS / CRASH_KEEP
+    scrub(text)                  → 脱敏后的字符串
+    prune(keep_days, dry)        → {"removed": [...], "freed": bytes, ...}
+    bundle(include_turns=0)      → {"ok", "path", "bytes", "items", ...}
+"""
+import datetime
+import json
+import os
+import platform
+import re
+import sys
+import time
+import zipfile
+
+import applog
+import diag
+import secret
+
+KEEP_DAYS = max(1, int(os.environ.get("WA2_LOG_KEEP_DAYS") or 14))
+CRASH_KEEP = 10
+MAX_LOG_CHARS = 400000          # 单个日志在包里最多留 40 万字（尾部）
+
+_RE_APP = re.compile(r"^app-(\d{8})\.log$")
+_RE_PERF = re.compile(r"^perf-(\d{4}-\d{2}-\d{2})\.csv$")
+_RE_CRASH = re.compile(r"^crash-?(\d{4}-\d{2}-\d{2})[_-](\d{2}-\d{2}-\d{2})")
+_RE_QUERY = re.compile(r"(/api/(?:text|tts)\?)[^\s\"'<>]*")
+_RE_WINUSER = re.compile(r"[A-Za-z]:\\Users\\[^\\/:*?\"'<>|\r\n]+", re.I)
+_RE_WINPATH = re.compile(r"[A-Za-z]:\\[^\s\"'<>|]*")
+_RE_UNCPATH = re.compile(r"\\\\[^\s\"'<>|]+")
+_RE_POSIX = re.compile(r"/(?:home|Users)/[^\s\"'<>|]+")
+
+
+# ------------------------------------------------------------------ 路径
+
+def _exe_dir():
+    """配置目录。和 main.py 的 EXE_DIR 同一套规则（打包后是 exe 旁边，开发时是 src/）。
+
+    这里不 import main：main 一导入就会起预热线程（字模 / 语音），导出日志这种事不该有副作用。
+    """
+    if getattr(sys, "frozen", False):
+        return os.path.dirname(os.path.abspath(sys.executable))
+    return os.path.dirname(os.path.abspath(__file__))
+
+
+def log_dir():
+    try:
+        return applog._log_dir()
+    except Exception:
+        return os.environ.get("TEMP", ".")
+
+
+# ------------------------------------------------------------------ 脱敏
+
+def _scrub_paths(s):
+    home = os.path.expanduser("~")
+    if home and home in s:
+        s = s.replace(home, "%USERPROFILE%")
+    s = s.replace(home.replace("\\", "/"), "%USERPROFILE%")
+    s = _RE_WINUSER.sub("%USERPROFILE%", s)
+    s = _RE_POSIX.sub("%USERPROFILE%", s)
+
+    def _short(m):
+        raw = m.group(0)
+        name = re.split(r"[\\/]", raw.rstrip("\\/"))[-1]
+        return "…\\" + name if name else "…"
+
+    s = _RE_WINPATH.sub(_short, s)
+    s = _RE_UNCPATH.sub(_short, s)
+    return s
+
+
+def scrub(text):
+    """导出前的统一脱敏：密钥 → 查询串 → 绝对路径 / 用户名。"""
+    if text is None:
+        return ""
+    s = str(text)
+    try:
+        s = secret.redact(s)
+    except Exception:
+        pass
+    s = _RE_QUERY.sub(lambda m: m.group(1) + "<已隐藏>", s)
+    s = _scrub_paths(s)
+    return s
+
+
+def _tail_text(s, max_chars=MAX_LOG_CHARS):
+    """太长的日志只留尾巴（报错通常在最后）；先截再脱敏也没问题，这里顺序是先脱敏后截。"""
+    if len(s) <= max_chars:
+        return s
+    return "…（前面省略 %d 字）…\n" % (len(s) - max_chars) + s[-max_chars:]
+
+
+def _scrub_obj(obj):
+    """递归脱敏 dict / list 里的字符串值。
+
+    JSON 要先结构脱敏再 dumps：直接对 dumps 出来的文本做正则，会把 `\\\\` 这类
+    转义序列改坏（Windows 路径在 JSON 里就是 `D:\\\\games`）。
+    """
+    if isinstance(obj, dict):
+        return {k: _scrub_obj(v) for k, v in obj.items()}
+    if isinstance(obj, list):
+        return [_scrub_obj(v) for v in obj]
+    if isinstance(obj, str):
+        return scrub(obj)
+    return obj
+
+
+# ------------------------------------------------------------------ 按天清理
+
+def _app_logs(d=None):
+    """[(日期, 路径)]，按日期升序"""
+    d = d or log_dir()
+    out = []
+    try:
+        for fn in os.listdir(d):
+            m = _RE_APP.match(fn)
+            if m:
+                out.append((m.group(1), os.path.join(d, fn)))
+    except OSError:
+        pass
+    return sorted(out)
+
+
+def _perf_files(d=None):
+    """[(日期, 路径)]，性能采样 csv（#14），按日期升序"""
+    d = d or log_dir()
+    out = []
+    try:
+        for fn in os.listdir(d):
+            m = _RE_PERF.match(fn)
+            if m:
+                out.append((m.group(1), os.path.join(d, fn)))
+    except OSError:
+        pass
+    return sorted(out)
+
+
+def _crash_logs(d=None):
+    """[(时间串, 路径)]，按时间升序"""
+    d = d or log_dir()
+    out = []
+    try:
+        for fn in os.listdir(d):
+            if fn.startswith("crash_") and (fn.endswith(".log") or fn.endswith("_auto.json")):
+                m = _RE_CRASH.match(fn)
+                key = (m.group(1) + "_" + m.group(2)) if m else fn
+                out.append((key, os.path.join(d, fn)))
+    except OSError:
+        pass
+    return sorted(out)
+
+
+def prune(keep_days=KEEP_DAYS, dry=False, d=None):
+    """删掉过期日志。返回 {"removed": [...], "freed": 字节, "kept": n, "dry": bool}"""
+    d = d or log_dir()
+    keep_days = max(1, int(keep_days or KEEP_DAYS))
+    cutoff = datetime.date.today() - datetime.timedelta(days=keep_days - 1)
+    active = ""
+    try:
+        active = os.path.abspath(applog.path() or "")
+    except Exception:
+        pass
+
+    removed, freed, kept = [], 0, 0
+    for day, path in _app_logs(d):
+        try:
+            when = datetime.datetime.strptime(day, "%Y%m%d").date()
+        except ValueError:
+            continue
+        if os.path.abspath(path) == active:      # 正在写的那个永远不删
+            kept += 1
+            continue
+        if when < cutoff:
+            try:
+                size = os.path.getsize(path)
+                if not dry:
+                    os.remove(path)
+                removed.append(os.path.basename(path))
+                freed += size
+            except OSError:
+                pass
+        else:
+            kept += 1
+
+    crashes = _crash_logs(d)
+    if len(crashes) > CRASH_KEEP:
+        for _key, path in crashes[:-CRASH_KEEP]:
+            try:
+                size = os.path.getsize(path)
+                if not dry:
+                    os.remove(path)
+                removed.append(os.path.basename(path))
+                freed += size
+            except OSError:
+                pass
+
+    # 性能采样 csv 也按同一个保留天数滚（#14）
+    for day, path in _perf_files(d):
+        try:
+            when = datetime.datetime.strptime(day, "%Y-%m-%d").date()
+        except ValueError:
+            continue
+        if when < cutoff:
+            try:
+                size = os.path.getsize(path)
+                if not dry:
+                    os.remove(path)
+                removed.append(os.path.basename(path))
+                freed += size
+            except OSError:
+                pass
+
+    if removed:
+        try:
+            applog.log("日志清理：删掉 %d 个旧文件（%d 天保留），释放 %.1f KB"
+                       % (len(removed), keep_days, freed / 1024.0), "WARN")
+        except Exception:
+            pass
+    return {"removed": removed, "freed": freed, "kept": kept, "dry": dry,
+            "keep_days": keep_days}
+
+
+# ------------------------------------------------------------------ 诊断包
+
+def _read_text(path, limit=2 * 1024 * 1024):
+    try:
+        with open(path, "rb") as f:
+            raw = f.read(limit)
+        return raw.decode("utf-8", "replace")
+    except Exception:
+        return ""
+
+
+def _read_json(path):
+    try:
+        with open(path, encoding="utf-8") as f:
+            return json.load(f)
+    except Exception:
+        return None
+
+
+def _version_info():
+    info = {"app": "WHITE ALBUM2 Extension", "version": "", "at": time.strftime("%Y-%m-%d %H:%M:%S"),
+            "pid": os.getpid(), "python": sys.version.split()[0],
+            "os": platform.platform(), "log_keep_days": KEEP_DAYS}
+    try:
+        import version
+        info["version"] = version.VERSION
+    except Exception:
+        pass
+    try:
+        info["uptime_s"] = diag.uptime_s()
+    except Exception:
+        pass
+    return info
+
+
+def _config_summary(exe_dir=""):
+    """配置摘要：只带「不该怕被人看到」的字段，key 一律掩码。"""
+    exe_dir = exe_dir or _exe_dir()
+    out = {"prefs_file": "", "config_file": "", "key_source": ""}
+    try:
+        out["key_source"] = secret.source()
+    except Exception:
+        pass
+    prefs = _read_json(os.path.join(exe_dir, "prefs.json"))
+    if isinstance(prefs, dict):
+        out["prefs_file"] = os.path.basename("prefs.json")
+        safe = {k: v for k, v in prefs.items()
+                if k not in ("apiKey", "api_key", "key", "token")}
+        out["prefs"] = safe
+    cfg = _read_json(os.path.join(exe_dir, "config.json"))
+    if isinstance(cfg, dict):
+        out["config"] = {
+            "base_url": cfg.get("base_url") or "",
+            "model": cfg.get("model") or "",
+            "api_key": secret.mask(cfg.get("api_key") or "") or ("(环境变量)" if out["key_source"] == "env" else ""),
+        }
+        voice = cfg.get("voice")
+        if isinstance(voice, dict):
+            out["config"]["voice"] = {k: v for k, v in voice.items()
+                                      if k in ("api_url", "endpoint", "model", "enabled")}
+    return out
+
+
+def _conversation(turns):
+    """最近 N 轮对话（来自当前角色的自动存档）；每段都过 scrub。"""
+    if turns <= 0:
+        return None
+    try:
+        import sessions
+        path = os.path.join(sessions.SESS_DIR, "auto.json")
+    except Exception:
+        return None
+    d = _read_json(path)
+    if not isinstance(d, dict):
+        return None
+    msgs = d.get("messages") or []
+    keep = msgs[-turns * 2:]
+    return {
+        "note": "这是你选择包含的最近 %d 轮对话；发送给任何人之前请先看一遍。" % turns,
+        "slot": d.get("slot") or "auto",
+        "time": d.get("time") or "",
+        "messages": [{"role": m.get("role"), "content": scrub(m.get("content") or ""),
+                      **({"zh": scrub(m.get("zh"))} if m.get("zh") else {})}
+                     for m in keep],
+    }
+
+
+def bundle(include_turns=0, out_dir="", d=None, exe_dir=""):
+    """打一个诊断包（zip）。默认**不含对话原文**。"""
+    d = d or log_dir()
+    include_turns = max(0, min(200, int(include_turns or 0)))
+    pruned = prune(d=d)
+    ts = time.strftime("%Y%m%d_%H%M%S")
+    out_dir = out_dir or d
+    try:
+        os.makedirs(out_dir, exist_ok=True)
+    except Exception:
+        out_dir = d
+    path = os.path.join(out_dir, "wa2_diag_%s.zip" % ts)
+
+    items = []
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
+        def put(name, text):
+            """text 必须是**已经脱敏好**的：JSON 走 _scrub_obj，纯文本走 scrub。"""
+            z.writestr(name, text)
+            items.append(name)
+
+        def put_json(name, obj):
+            put(name, json.dumps(_scrub_obj(obj), ensure_ascii=False, indent=1))
+
+        # 版本 / 环境
+        put_json("version.json", _version_info())
+        env_lines = ["WA2_* 环境变量（值已脱敏，只说明有没有设）："]
+        for k in sorted(os.environ):
+            if k.startswith("WA2_"):
+                v = os.environ[k]
+                env_lines.append("  %s = %s" % (k, secret.mask(v) if "KEY" in k.upper() else scrub(v)))
+        put("env.txt", "\n".join(env_lines) + "\n")
+
+        # 日志（最近 N 天）
+        for _day, lp in _app_logs(d):
+            put("logs/" + os.path.basename(lp), _tail_text(scrub(_read_text(lp))))
+        crash = _crash_logs(d)[-3:]
+        for _k, cp in crash:
+            put("logs/" + os.path.basename(cp), _tail_text(scrub(_read_text(cp))))
+        # 性能采样 csv（#14）：纯数字，原样带上
+        for _pday, pp in _perf_files(d)[-KEEP_DAYS:]:
+            put("logs/" + os.path.basename(pp), _read_text(pp, 512 * 1024))
+
+        # 素材报告 / 运行状态 / 调试状态
+        rep = _read_json(os.path.join(d, "asset_report.json"))
+        if rep is not None:
+            put_json("asset_report.json", rep)
+        st = _read_json(os.path.join(d, "run_state.json"))
+        if st is not None:
+            put_json("run_state.json", st)
+        try:
+            put_json("diag_state.json", diag.snapshot())
+        except Exception:
+            pass
+
+        # 配置摘要（脱敏）
+        put_json("config_summary.json", _config_summary(exe_dir))
+
+        # 可选：最近 N 轮对话
+        conv = _conversation(include_turns)
+        if conv is not None:
+            put_json("conversation.json", conv)
+
+        readme = [
+            "WHITE ALBUM2 Extension 诊断包",
+            "生成时间: %s" % time.strftime("%Y-%m-%d %H:%M:%S"),
+            "",
+            "包含：",
+            "  version.json          版本 / Python / 系统 / 运行时长",
+            "  env.txt               设置了哪些 WA2_* 环境变量（值已脱敏）",
+            "  logs/                 最近 %d 天的运行日志 + 最近 3 份崩溃现场" % KEEP_DAYS,
+            "  asset_report.json     素材自检（缺图 / 0 字节）",
+            "  run_state.json        上次是不是正常退出",
+            "  diag_state.json       提示词分段 / 缓存命中 / 关系阶段等只读指标",
+            "  config_summary.json   配置摘要（key 只有掩码）",
+            "",
+            "脱敏：",
+            "  · API 密钥（key / Bearer token）已抹掉，只剩掩码",
+            "  · /api/text 与 /api/tts 的查询串（对话 / 朗读文本）已替换成 <已隐藏>",
+            "  · 用户目录替换成 %USERPROFILE%，其它绝对路径只留文件名",
+            "",
+        ]
+        if conv is not None:
+            readme.append("注意：这个包**包含最近 %d 轮对话原文**（conversation.json）。" % include_turns)
+            readme.append("      发给别人之前先自己看一遍，确认没有不想外传的内容。")
+        else:
+            readme.append("默认不含对话原文；确实需要时用 /api/log/bundle?turns=20 生成。")
+        put("README.txt", "\n".join(readme) + "\n")
+
+    size = os.path.getsize(path)
+    try:
+        applog.log("诊断包：%s（%d 个条目，%.1f KB，对话 %d 轮）"
+                   % (os.path.basename(path), len(items), size / 1024.0, include_turns), "WARN")
+    except Exception:
+        pass
+    return {"ok": True, "path": path, "bytes": size, "items": items,
+            "include_turns": include_turns, "pruned": len(pruned["removed"]),
+            "note": ("含最近 %d 轮对话，发出前先看一遍" % include_turns) if include_turns else "不含对话原文"}
