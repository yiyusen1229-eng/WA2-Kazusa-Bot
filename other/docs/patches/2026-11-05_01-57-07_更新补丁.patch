+        return s
+    s = _RE_SK.sub(MASK, s)
+    s = _RE_BEARER.sub(lambda m: m.group(1) + MASK, s)
+    s = _RE_KV.sub(lambda m: m.group(1) + MASK, s)
+    return s
+
