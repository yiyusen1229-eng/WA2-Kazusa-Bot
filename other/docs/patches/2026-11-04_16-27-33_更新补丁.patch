+# 产物名：和纱_<版本号>_<时间戳>（版本号取 src/version.py，时间戳带时分秒）
+def _read_version():
+    try:
+        t = io.open(os.path.join(SRC, "version.py"), encoding="utf-8").read()
+        m = re.search(r'VERSION\s*=\s*["\']([^"\']+)["\']', t)
+        return m.group(1) if m else "dev"
+    except Exception:
+        return "dev"
+
