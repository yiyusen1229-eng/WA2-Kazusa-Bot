+def _copy_characters(src, dst):
+    """角色文件夹要带上，但**不能带存档 / 缓存**（用户的聊天记录不该进安装包）"""
+    skip_dirs = {"sessions", "cache", "logs", "text_cache", "__pycache__"}
+    skip_chars = {"新角色"}          # 测试时新建的占位角色，不进包
+    for dp, dns, fns in os.walk(src):
